// Cloudflare Workers deployment config.
// site/dist is produced by `npm run build` and served as static assets, honoring
// its _headers file. The Worker script exists only for /api/* (play counts and
// ratings, see workers/site/index.js) — every other request goes to the assets
// untouched, so the site itself stays static.
{
  "name": "mz-catalog",
  "main": "workers/site/index.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "STATS",
      "database_name": "mz-catalog-stats",
      "database_id": "cf01df15-0caf-4981-a0b4-92f447d266a5"
    }
  ]
}
