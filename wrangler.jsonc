// Cloudflare Workers deployment config.
// site/dist is produced by `npm run build` and served as static assets, honoring
// its _headers file. The Worker script exists only for /api/* (play counts and
// ratings, see workers/site/index.js) — every other request goes to the assets
// untouched, so the site itself stays static.
{
  "name": "mz-catalog",
  "main": "workers/site/index.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Daily clean-up of short-lived rows (see prune() in the Worker).
  "triggers": { "crons": ["17 3 * * *", "0 7 * * 1"] },
  // The monitor (workers/site/metrics.js). Secrets set with `wrangler secret put`:
  // STATS_KEY (dashboard link), CF_ANALYTICS_TOKEN (read-only analytics token),
  // REPORT_TO (a verified Email Routing destination for the weekly mail).
  "vars": { "ZONE_ID": "e335ff5884e852f2f6c333c823d4ef1a", "SITE_HOST": "mzpico.com", "SITE_URL": "https://mzpico.com" },
  "send_email": [{ "name": "REPORT_MAIL" }],
  "d1_databases": [
    {
      "binding": "STATS",
      "database_name": "mz-catalog-stats",
      "database_id": "cf01df15-0caf-4981-a0b4-92f447d266a5"
    }
  ]
}
