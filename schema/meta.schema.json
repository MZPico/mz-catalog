{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mzpico.com/schema/meta.schema.json",
  "title": "mz-catalog title metadata",
  "description": "Schema for titles/<slug>/meta.yaml. One document per software title.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "machine",
    "genre",
    "files"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Display name of the title."
    },
    "year": {
      "type": "integer",
      "minimum": 1978,
      "maximum": 2100,
      "description": "Year of release. Omit if unknown."
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Publisher, author or group. Omit if unknown."
    },
    "genre": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "game",
          "arcade",
          "adventure",
          "puzzle",
          "strategy",
          "sports",
          "simulation",
          "rpg",
          "text",
          "demo",
          "utility",
          "language",
          "education",
          "music",
          "graphics",
          "system",
          "other"
        ]
      }
    },
    "machine": {
      "enum": [
        "mz-700",
        "mz-800",
        "mz-1500"
      ],
      "description": "Machine the title was written for."
    },
    "mode": {
      "enum": [
        "native",
        "mz-700"
      ],
      "description": "MZ-800 only: runs in native MZ-800 mode or in MZ-700 compatibility mode."
    },
    "port": {
      "description": "Machine this title was converted from, when it is not an MZ original. Derived for the bootstrap import from the legacy games-zx folder; correct it when a title turns out to be an original.",
      "enum": [
        "zx-spectrum",
        "msx",
        "c64",
        "atari",
        "arcade"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$",
      "description": "ISO 639 code of the language the software speaks to the user in (en, cs, de, ja, ...). Omit if unknown."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "description": {
      "description": "Free prose about the title. Either a plain string (English) or a per-language map; en is required and is the fallback for languages that are missing.",
      "oneOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en"
          ],
          "properties": {
            "en": {
              "type": "string",
              "maxLength": 4000
            },
            "cs": {
              "type": "string",
              "maxLength": 4000
            },
            "de": {
              "type": "string",
              "maxLength": 4000
            },
            "ja": {
              "type": "string",
              "maxLength": 4000
            }
          }
        }
      ]
    },
    "controls": {
      "type": "string",
      "maxLength": 2000,
      "description": "Keys / joystick usage."
    },
    "source": {
      "type": "string",
      "maxLength": 500,
      "description": "Where the dump came from (URL or free text)."
    },
    "touch": {
      "type": "object",
      "additionalProperties": false,
      "description": "Touch-control layout for the browser emulator on phones. Defaults when absent: pad = cursor keys, buttons FIRE (Space) and RET (Enter).",
      "properties": {
        "pad": {
          "description": "Direction pad: 'cursor', 'wasd', 'none', or explicit keys.",
          "oneOf": [
            {
              "enum": [
                "cursor",
                "wasd",
                "none"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "up",
                "down",
                "left",
                "right"
              ],
              "properties": {
                "up": {
                  "$ref": "#/$defs/touchKey"
                },
                "down": {
                  "$ref": "#/$defs/touchKey"
                },
                "left": {
                  "$ref": "#/$defs/touchKey"
                },
                "right": {
                  "$ref": "#/$defs/touchKey"
                }
              }
            }
          ]
        },
        "buttons": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/touchButton"
          },
          "description": "Main action buttons (right side), first = primary/largest."
        },
        "extra": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/touchButton"
          },
          "description": "Additional small buttons on the left side (start keys, weapon select, ...)."
        }
      }
    },
    "web": {
      "type": "boolean",
      "description": "Published on the web site (title page, lists, search, play). Absent or false = hidden from the site; the file is still served via manifest.json and the device API."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "machine": {
            "const": "mz-800"
          }
        }
      },
      "then": {
        "required": [
          "mode"
        ]
      },
      "else": {
        "not": {
          "required": [
            "mode"
          ]
        }
      }
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.mzf$",
          "description": "File name inside the title folder (no subdirectories, lowercase .mzf extension)."
        },
        "kind": {
          "enum": [
            "standard",
            "turbo",
            "alt-dump"
          ],
          "description": "standard = normal tape format, turbo = turbo-loader variant, alt-dump = alternative dump of the same title."
        },
        "note": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional note, e.g. what differs in an alt-dump."
        }
      }
    },
    "touchKey": {
      "type": "string",
      "pattern": "^([A-Z]|[0-9]|Space|Enter|Up|Down|Left|Right|Shift|Ctrl|Tab|Backspace|Delete|Insert|Home|Escape|Graph|Alpha|Minus|Equal|Comma|Period|Slash|Semicolon|Quote|BracketLeft|BracketRight|F([1-9]|10))$",
      "description": "MZ key name: A-Z, 0-9, Space, Enter, Up/Down/Left/Right, Shift, Ctrl, Tab, Backspace, Delete, Insert, Home, Escape, Graph, Alpha, F1-F10, Minus, Equal, Comma, Period, Slash, Semicolon, Quote, BracketLeft, BracketRight."
    },
    "touchButton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "key"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6
        },
        "key": {
          "$ref": "#/$defs/touchKey"
        }
      }
    }
  }
}
