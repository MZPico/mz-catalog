 src/iface-video/sdlapp/sdlapp_imgui_video.cpp |  7 ++
 src/ui-imgui/bootstrap/myimgui.cpp            | 10 ++-
 src/ui-imgui/main_window.cpp                  |  5 +-
 5 files changed, 97 insertions(+), 3 deletions(-)

