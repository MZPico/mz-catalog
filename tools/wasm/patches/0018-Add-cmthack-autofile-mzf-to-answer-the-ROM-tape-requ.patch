From 44733042b8269b5a91907ee53667a6f2c30910ed Mon Sep 17 00:00:00 2001
From: Martin Matyas <martin.matyas@tietoevry.com>
Date: Tue, 1 Sep 2026 15:08:11 +0200
Subject: [PATCH 18/25] Add --cmthack-autofile <mzf> to answer the ROM tape
 request without a chooser

---
 src/emulator/hw-generic/cmt/cmthack.c | 7 ++++++-
 src/main.c                            | 2 ++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/emulator/hw-generic/cmt/cmthack.c b/src/emulator/hw-generic/cmt/cmthack.c
index 7b39abb..a319eb9 100644
--- a/src/emulator/hw-generic/cmt/cmthack.c
+++ b/src/emulator/hw-generic/cmt/cmthack.c
@@ -50,6 +50,7 @@
 
 #include "baseui/baseui.h"
 #include "baseui/baseui_filechooser.h"
+#include "libs/sdlapp/sdlapp_options.h"
 #include "libs/generic_driver/generic_driver.h"
 #include "generic_driver/memory_driver.h"
 #include "libs/mzf/mzf.h"
@@ -158,7 +159,11 @@ void cmthack_load_file(void)
     emulator_measuring_maxspeed_stall_begin();
     framebuffer_flush_full_screen();
 
-    char *filename = baseui_filechooser_open_file_wait(_("Select a MZF File"), ".mzf, .m12, .*", NULL, NULL, g_cmthack.last_filename, NULL);
+    /* --cmthack-autofile <path>: answer the ROM's tape request with this file
+     * instead of opening the chooser (headless automation / scripted runs). */
+    const char *autofile = sdlapp_option_value("--cmthack-autofile");
+    char *filename = autofile ? g_strdup(autofile)
+                              : baseui_filechooser_open_file_wait(_("Select a MZF File"), ".mzf, .m12, .*", NULL, NULL, g_cmthack.last_filename, NULL);
 
     if (filename == NULL)
     {
diff --git a/src/main.c b/src/main.c
index bb46c16..7ce8289 100644
--- a/src/main.c
+++ b/src/main.c
@@ -71,6 +71,8 @@ static const st_SDLAPP_OPTION_DEF g_known_options[] = {
 #endif
     { "--run-mzf",          SDLAPP_OPTION_VALUE, SDLAPP_OPTVAL_STRING,      NULL,        "<filepath>",
       "Automatically load and run the given MZF file after the emulator boots." },
+    { "--cmthack-autofile",          SDLAPP_OPTION_VALUE, SDLAPP_OPTVAL_STRING,      NULL,        "<filepath>",
+      "Answer the ROM tape-load request (CMT hack) with this MZF instead of a file chooser." },
     { "--cdl-mode",         SDLAPP_OPTION_VALUE, SDLAPP_OPTVAL_ENUM,        MODE_VALUES, "<off|window|always>",
       "Set the CDL (Memory Heatmap) recording mode." },
     { "--cdl-dir",          SDLAPP_OPTION_VALUE, SDLAPP_OPTVAL_STRING,      NULL,        "<dirpath>",
-- 
2.43.0

