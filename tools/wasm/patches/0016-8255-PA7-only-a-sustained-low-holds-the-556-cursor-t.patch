From 1e700dbff74907cb1cfb1b8acb01f0cd0891a8ed Mon Sep 17 00:00:00 2001
From: Martin Matyas <martin.matyas@tietoevry.com>
Date: Tue, 1 Sep 2026 15:08:11 +0200
Subject: [PATCH 16/22] 8255 PA7: only a sustained low holds the 556 cursor
 timer in reset

The emulator reset the cursor-blink timer on every port A write with
bit 7 clear. 1Z-016 BASIC pulses PA7 low on each keyboard scan
(xor a / out (D0h) / cpl / out (D0h) at 092Eh, ~1 kHz), which froze
PC6 at 0 and left BASIC's cursor solid, while a microsecond reset
pulse cannot discharge the timer capacitor on real hardware.

Ignore the pulse; a PA7 level still low at the end of a frame keeps
the timer reset (mz800_main_event_callback_screen_done). The MZ-700
monitor's blink (which never pulses PA7) is unchanged.
---
 src/emulator/hw-generic/pio8255/pio8255.c | 10 ++++++----
 src/emulator/mzarch/mzarch.c              |  6 ++++++
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/src/emulator/hw-generic/pio8255/pio8255.c b/src/emulator/hw-generic/pio8255/pio8255.c
index e064d1e..10f63b9 100644
--- a/src/emulator/hw-generic/pio8255/pio8255.c
+++ b/src/emulator/hw-generic/pio8255/pio8255.c
@@ -243,10 +243,12 @@ void pio8255_write(int addr, uint8_t value)
         g_pio8255.signal_PA_joy2_enabled = (!(value & 0x40)) ? 1 : 0;
 
         // 7. bit cursor timer reset - aktivni pri L
-        if (!(value & 0x80))
-        {
-            mz800_main_cursor_timer_reset();
-        };
+        /* PA7 = /RESET of the 556 cursor-blink timer. A reset that is only
+         * pulsed for a few microseconds cannot discharge the timing capacitor,
+         * so it does not disturb the blink phase on real hardware; 1Z-016 BASIC
+         * pulses PA7 low on every keyboard scan (~1 kHz) and its cursor still
+         * blinks. Only a level held low across a frame holds the timer in
+         * reset - see mz800_main_event_callback_screen_done(). */
 
         break;
 
diff --git a/src/emulator/mzarch/mzarch.c b/src/emulator/mzarch/mzarch.c
index 8c94168..694465e 100644
--- a/src/emulator/mzarch/mzarch.c
+++ b/src/emulator/mzarch/mzarch.c
@@ -137,6 +137,12 @@ static inline void mzarch_main_event_callback_20ms(unsigned event_ticks)
  */
 static inline void mz800_main_event_callback_screen_done(void)
 {
+    /* 556 cursor-blink timer: a PA7 low level that lasts across a whole frame
+     * holds the timer in reset (see pio8255_write, PORT A). */
+    if (!(g_pio8255.signal_PA & 0x80))
+    {
+        mz800_main_cursor_timer_reset();
+    };
 #ifdef MZ800EMU_CFG_CLK1M1_FAST
     ctc8253_on_screen_done_event();
 #endif
