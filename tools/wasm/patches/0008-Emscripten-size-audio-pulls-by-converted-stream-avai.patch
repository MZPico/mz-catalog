From c4ea337168528da74e8f52e2239dea90ffc6a5f9 Mon Sep 17 00:00:00 2001
From: Martin Matyas <martin.matyas@tietoevry.com>
Date: Tue, 1 Sep 2026 12:43:47 +0200
Subject: [PATCH 08/21] Emscripten: size audio pulls by converted stream
 availability (device rate may differ)

---
 src/iface-audio/sdl3/sdl3_audio.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/iface-audio/sdl3/sdl3_audio.c b/src/iface-audio/sdl3/sdl3_audio.c
index 7d9a712..ee524c7 100644
--- a/src/iface-audio/sdl3/sdl3_audio.c
+++ b/src/iface-audio/sdl3/sdl3_audio.c
@@ -54,8 +54,11 @@ static void SDLCALL sdl3_audio_callback(void *userdata, SDL_AudioStream *astream
      * frame (20 ms), so keep pulling frames until the device request is
      * satisfied; otherwise emulation would be capped at one frame per callback
      * and the stream would underrun (crackle) with any comfortable buffer. */
-    int supplied = 0;
-    while (supplied < additional_amount)
+    /* additional_amount is in *device* format (e.g. 48 kHz on Windows) while we
+     * feed 44.1 kHz frames, so measure what the stream has ready after its own
+     * conversion instead of counting the bytes we pushed. */
+    int guard = 0;
+    while (SDL_GetAudioStreamAvailable(astream) < additional_amount && guard++ < 16)
     {
         size_t samples_size = 0;
         float *samples = iface_audio_wait_for_data(&samples_size);
@@ -65,7 +68,6 @@ static void SDLCALL sdl3_audio_callback(void *userdata, SDL_AudioStream *astream
         };
         SDL_PutAudioStreamData(astream, samples, samples_size);
         SDL_free(samples);
-        supplied += (int)samples_size;
     }
 #else
     size_t samples_size = 0;
-- 
