From 7bd2a8cbf82dd8513eeff8ae85aced83997b7bd4 Mon Sep 17 00:00:00 2001
From: Martin Matyas <martin.matyas@tietoevry.com>
Date: Tue, 1 Sep 2026 10:02:14 +0200
Subject: [PATCH 03/22] Emscripten: skip glibc-internal gettext catalog counter

---
 src/emulator/i18n_lang.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/emulator/i18n_lang.c b/src/emulator/i18n_lang.c
index c4c1e77..1895d85 100644
--- a/src/emulator/i18n_lang.c
+++ b/src/emulator/i18n_lang.c
@@ -140,7 +140,9 @@ void i18n_lang_set(en_I18N_LANG lang)
 
     /* Vynutit znovunačtení překladů */
     {
+#ifndef __EMSCRIPTEN__ /* glibc-internal hook; Emscripten's libc has no catalog cache */
         extern int _nl_msg_cat_cntr;
         ++_nl_msg_cat_cntr;
+#endif
     }
 }
