// Deploy: npx wrangler deploy -c workers/api-shim/wrangler.jsonc
// Route api.mzpico.com/* requires the mzpico.com zone (already on Cloudflare)
// and the `api` DNS record flipped from the Oracle VM to a proxied record.
{
  "name": "mzpico-api-shim",
  "main": "index.js",
  "compatibility_date": "2026-08-31",
  // Usage counts go to the site's statistics database (production only — the
  // card talks to api.mzpico.com alone). Secret: STATS_SALT (own value).
  "d1_databases": [
    { "binding": "STATS", "database_name": "mz-catalog-stats", "database_id": "cf01df15-0caf-4981-a0b4-92f447d266a5" }
  ],
  "routes": [
    { "pattern": "api.mzpico.com/*", "zone_name": "mzpico.com" }
  ],
  // Multiplayer relay for the physical card: ws://api.mzpico.com/net (this host is
  // plain HTTP, the Pico speaks no TLS). The rooms are the site Worker's Durable
  // Objects (script_name), so a card and a browser meet in the same room. Deploy
  // the site Worker (mz-catalog) first: the class must exist before this binds to it.
  "durable_objects": { "bindings": [{ "name": "NET_ROOM", "class_name": "NetRoom", "script_name": "mz-catalog" }] }
}
