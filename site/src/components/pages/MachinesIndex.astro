---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { machines } from '../../data/machines';
import { useTranslations, localizePath, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const titles = (await getCollection('titles')).filter((e) => e.data.web);
---
<Base lang={lang} title={t.machines.h1}>
  <h1>{t.machines.h1}</h1>
  <p class="lead">{t.machines.lead}</p>
  {machines.map((m) => (
    <section>
      <h2><a href={localizePath(lang, `/machines/${m.id}/`)}>{m.name}</a> <span class="meta">· {m.years}</span></h2>
      <p class="prose">{t.machineInfo[m.id as keyof typeof t.machineInfo].intro}</p>
    </section>
  ))}
</Base>
