---
import Base from '../../layouts/Base.astro';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { useTranslations, localizePath, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const tt = t.studio;
// Content stamp of the emulator build, so a new one is not served from cache.
const emuVersion = createHash('md5')
  .update(readFileSync(new URL('../../../public/play/emu/mz800emu.wasm', import.meta.url)))
  .digest('hex')
  .slice(0, 8);
// Everything the client script needs to speak the visitor's language.
const ui = {
  ...Object.fromEntries(Object.entries(tt).filter(([, v]) => typeof v === 'string')),
  identifiedAs: tt.identifiedAs('{title}'),
  kinds: tt.kinds,
  titlePath: localizePath(lang, '/titles/'),
  playPath: localizePath(lang, '/play/'),
};
---
<Base lang={lang} title={tt.title} description={tt.description}>
  <article class="wb">
    <header class="wb-head">
      <h1>{tt.h1}</h1>
    </header>

    <div class="dropbar wb-drop" id="drop" data-ui={JSON.stringify(ui)}>
      <input type="file" id="files" multiple hidden />
      <button class="btn primary" type="button" id="pick">{tt.choose}</button>
      <span class="meta">{tt.drop} · {tt.nothingUploaded}</span>
      <button class="btn ghost small" type="button" id="forget" hidden>{tt.forgetAll}</button>
    </div>

    <!-- The machine comes first: on a narrow screen it is what you see, and on a
         wide one everything else sits around it. -->
    <section class="wb-screen" aria-label={tt.emuTitle}>
      <div class="emu-screen" id="emu-frame">
        <!-- SDL's Emscripten backend looks the canvas up by this id; it cannot be renamed. -->
        <canvas id="canvas" tabindex="0" width="928" height="576"></canvas>
      </div>
      <div class="emu-controls">
        <button type="button" class="btn secondary small" id="emu-reset">{tt.resetMachine}</button>
        <button type="button" class="btn secondary small" id="emu-mute">{t.play.mute}</button>
        <button type="button" class="btn secondary small" id="emu-fs">{t.play.fullscreen}</button>
        <!-- Shows up once a setting the machine only reads at start has changed. -->
        <button type="button" class="btn primary small" id="apply" hidden>{tt.applyRestart}</button>
        <span class="meta" id="emu-status"></span>
        <!-- The program injected at start: the one setting with no device to live on. -->
        <span class="emu-prog meta" id="emu-prog" hidden><span></span><button type="button" class="wb-close" title={tt.remove} aria-label={tt.remove}>✕</button></span>
      </div>
      <!-- The machine's own keyboard, for the keys a PC has nowhere sensible. -->
      <div id="mzkbd" class="mzkbd" aria-label={tt.keyboard}></div>
      <!-- What you hold: the joysticks, and the MZ-821's data recorder. -->
      <div class="desk">
        <div id="dev-desk" class="devices desk-devs" aria-label={tt.joysticks}></div>
        <div id="mzcmt" class="mzcmt" aria-label={tt.recorder}></div>
      </div>
      <!-- Where a file goes: the drives, with the file's own details under them. -->
      <h2 class="wb-h">{tt.storage}</h2>
      <div id="dev-storage" class="devices storage" aria-label={tt.storage}></div>
      <div id="wb-panel" class="wb-panel"></div>
    </section>

    <aside class="wb-left">
      <h2 class="wb-h">{tt.yourFiles}</h2>
      <ul id="filelist" class="wb-list"></ul>
      <p class="meta" id="noFiles">{tt.empty}</p>
      <div id="workbench" hidden>
        <div id="wb-actions" class="wb-actions"></div>
        <p class="meta" id="wb-say" hidden></p>
      </div>
    </aside>

    <aside class="wb-right">
      <h2 class="wb-h">{tt.machine}</h2>
      <!-- The cards inside the case, drawn as they look; each carries its own settings. -->
      <div class="devices cards" id="devices" data-emu={emuVersion} aria-label={tt.devices}></div>
    </aside>
  </article>

  <script>
    import { load, actionsFor, catalogIndex, formatSize, type LoadedFile } from '../../lib/mz/workbench';
    import { setStrings } from '../../lib/mz/panels';
    import { keyboard } from '../../lib/mz/keyboard';
    import { recorder } from '../../lib/mz/recorder';
    import { devices } from '../../lib/mz/devices';
    import { listFiles, rememberFile, forgetFile, forgetAll } from '../../lib/mz/store';
    import { boot, running, frames, wake, reset as resetMachine, mountFloppy, ejectFloppy, mountQd, protectQd, runMzf,
      cmtInsert, cmtPlay, cmtStop, cmtRecord, cmtHack, cmtState, cmtPlaytime, setMuted, writeFile, readBack } from '../../lib/mz/emulator';
    import { defaults, toIni, mediaOf, argsOf, mediaPath, type Machine } from '../../lib/mz/machine';

    const drop = document.getElementById('drop')!;
    const ui = JSON.parse(drop.dataset.ui!) as Record<string, any>;
    setStrings(ui);
    const esc = (s: unknown) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const track = (e: string) => (window as unknown as { mzEvent?: (e: string) => void }).mzEvent?.(e);

    const files: LoadedFile[] = [];
    let current: LoadedFile | null = null;
    let openAction = '';

    const label = (id: string) => ui['act' + id.replace(/(^|-)([a-z])/g, (_: string, __: string, c: string) => c.toUpperCase())] ?? id;

    function renderList() {
      const list = $('filelist');
      $('noFiles').hidden = files.length > 0;
      $('forget').hidden = files.length === 0;
      list.innerHTML = files.map((f) => {
        const known = f.catalog ? ` · <a href="${esc(ui.titlePath + f.catalog.slug)}/">${esc(f.catalog.title)}</a>` : '';
        return `<li class="${f === current ? 'on' : ''}" data-id="${esc(f.id)}">
          <button type="button" class="wb-pick">
            <b>${esc(f.name)}</b>
            <span class="meta">${esc(formatSize(f.bytes.length))} · ${esc(ui.kinds[f.kind] ?? f.kind)}</span>
          </button>
          <span class="meta wb-known">${known}</span>
          <button type="button" class="wb-close" title="${esc(ui.remove)}" aria-label="${esc(ui.remove)}">✕</button>
        </li>`;
      }).join('');
      for (const li of list.querySelectorAll<HTMLElement>('li')) {
        const file = files.find((f) => f.id === li.dataset.id)!;
        li.querySelector('.wb-pick')!.addEventListener('click', () => select(file));
        li.querySelector('.wb-close')!.addEventListener('click', () => {
          files.splice(files.indexOf(file), 1);
          forgetFile(file.id);
          if (current === file) { current = files[0] ?? null; openAction = ''; }
          renderList(); renderActions();
        });
      }
    }

    function renderActions() {
      const box = $('workbench');
      box.hidden = !current;
      if (!current) return;
      const groups: Record<string, string[]> = {};
      for (const a of actionsFor(current)) (groups[a.group] ??= []).push(a.id);
      // Straight into the machine in the middle: a program to run, a disk to put in.
      const intoMachine = { mzf: 'emu-run', dsk: 'emu-drive', mzq: 'emu-qd' }[current.kind as string];
      if (intoMachine) (groups.use ??= []).unshift(intoMachine);
      if (current.kind === 'mzf') (groups.use ??= []).splice(1, 0, 'emu-tape');
      // A dump the catalog knows can be played straight away.
      if (current.catalog) (groups.use ??= []).push('play');
      const order = ['inspect', 'convert', 'use', 'share'] as const;
      $('wb-actions').innerHTML = order.filter((g) => groups[g]?.length).map((g) => `
        <div class="wb-group"><span class="wb-glabel">${esc(ui['group' + g[0].toUpperCase() + g.slice(1)])}</span>
          ${groups[g].map((id) => id === 'play'
            ? `<a class="btn secondary" href="${esc(ui.playPath + current!.catalog!.slug)}/">${esc(ui.actPlay)}</a>`
            : id.startsWith('emu-')
            ? `<button class="btn ${id === 'emu-tape' ? 'secondary' : 'primary'}" type="button" data-emu="${esc(id)}">${esc(ui[id === 'emu-run' ? 'actRun' : id === 'emu-drive' ? 'actDrive' : id === 'emu-tape' ? 'actTape' : 'actQd'])}</button>`
            : `<button class="btn secondary${openAction === id ? ' active' : ''}" type="button" data-act="${esc(id)}">${esc(label(id))}</button>`).join('')}
        </div>`).join('');
      for (const b of $('wb-actions').querySelectorAll<HTMLButtonElement>('button[data-act]')) {
        b.addEventListener('click', () => run(b.dataset.act!));
      }
      for (const b of $('wb-actions').querySelectorAll<HTMLButtonElement>('button[data-emu]')) {
        b.addEventListener('click', () => sendToMachine(b.dataset.emu!));
      }
      if (openAction) run(openAction, true);
    }

    async function run(id: string, keep = false) {
      if (!current) return;
      const action = actionsFor(current).find((a) => a.id === id);
      if (!action) return;
      const panel = $('wb-panel');
      const say = (message: string) => { const el = $('wb-say'); el.textContent = message; el.hidden = false; setTimeout(() => { el.hidden = true; }, 2500); };
      if (action.panel) {
        if (!keep && openAction === id) { openAction = ''; panel.innerHTML = ''; renderActions(); return; }
        openAction = id;
        panel.innerHTML = '';
        await action.run({ file: current, panel, say });
        if (!keep) renderActions();
      } else {
        await action.run({ file: current, panel, say });
      }
      track('tool-' + id);
    }

    function select(file: LoadedFile) {
      current = file;
      openAction = file.kind === 'mzf' ? 'header' : 'bytes';
      renderList(); renderActions();
    }

    async function add(fileList: FileList | null) {
      for (const f of [...(fileList ?? [])]) {
        const file = load(f.name, new Uint8Array(await f.arrayBuffer()));
        // The same file brought twice replaces the copy that is already here.
        const same = files.findIndex((o) => o.name === file.name && o.bytes.length === file.bytes.length);
        if (same >= 0) { forgetFile(files[same].id); files.splice(same, 1); }
        files.unshift(file);
        select(file);
        track('tool-open');
        // Kept in this browser, so a reload does not throw the work away.
        rememberFile({ id: file.id, name: file.name, bytes: file.bytes, ts: Date.now() });
        if (file.mzf) {
          file.catalog = (await catalogIndex()).get(file.mzf.crc32) ?? null;
          renderList(); renderActions();
        }
        renderMachine();
      }
    }

    const input = $<HTMLInputElement>('files');
    $('pick').addEventListener('click', () => input.click());
    input.addEventListener('change', () => add(input.files));
    for (const type of ['dragenter', 'dragover']) drop.addEventListener(type, (e) => { e.preventDefault(); drop.classList.add('over'); });
    for (const type of ['dragleave', 'drop']) drop.addEventListener(type, () => drop.classList.remove('over'));
    for (const target of [drop, document.body]) {
      target.addEventListener('drop', (e) => { e.preventDefault(); add((e as DragEvent).dataTransfer?.files ?? null); });
      target.addEventListener('dragover', (e) => e.preventDefault());
    }

    // Whatever was open last time, back as it was.
    (async () => {
      try { for (const stored of await listFiles()) files.push(load(stored.name, stored.bytes, stored.id)); } catch { /* no store */ }
      if (files.length) {
        select(files[0]);
        const index = await catalogIndex();
        for (const file of files) if (file.mzf) file.catalog = index.get(file.mzf.crc32) ?? null;
        renderList(); renderActions();
        renderMachine();   // the devices can name their disks now
      }
      // The machine is on as soon as its disks are back: there is nothing to
      // press first. Sound waits for the first click or key, as browsers insist.
      startMachine();
    })();

    $('forget').addEventListener('click', () => {
      files.length = 0; current = null; openAction = '';
      forgetAll();
      $('wb-panel').innerHTML = '';
      renderList(); renderActions();
    });


    // ---------------------------------------------------------------- emulator
    const EMU_VERSION = $('devices').dataset.emu ?? '1';
    let machine: Machine = defaults();
    try { machine = { ...defaults(), ...JSON.parse(localStorage.getItem('mz-machine') ?? '{}') }; } catch { /* first visit */ }
    const saveMachine = () => { try { localStorage.setItem('mz-machine', JSON.stringify(machine)); } catch { /* private mode */ } };

    const fileById = (id: string) => files.find((f) => f.id === id) ?? null;

    /** Every setting lives on its device; this is what the devices call. */
    function setMachine(path: string, value: unknown) {
      setAt(machine as unknown as Record<string, unknown>, path, value);
      // A disk in a drive is no use with the controller switched off.
      if (value && /^fdc\.drives\.\d+\.file$/.test(path) && !machine.fdc.connected) { machine.fdc.connected = true; markDirty('fdc.connected'); }
      if (value && path === 'qdisk.file' && !machine.qdisk.connected) { machine.qdisk.connected = true; markDirty('qdisk.connected'); }
      saveMachine();
      markDirty(path);
      renderMachine();
    }

    /** The pictures follow the machine; the program chip under the screen too. */
    function renderMachine() {
      const prog = $('emu-prog');
      const name = fileById(machine.program)?.name ?? '';
      prog.hidden = !name;
      prog.firstElementChild!.textContent = `${ui.programNote} ${name}`;
      drawDevices?.();
      drawDeck?.();
    }
    $('emu-prog').querySelector('button')!.addEventListener('click', () => setMachine('program', ''));

    function setAt(obj: Record<string, unknown>, path: string, value: unknown) {
      const parts = path.split('.');
      let node = obj as Record<string, unknown>;
      for (const part of parts.slice(0, -1)) node = node[part] as Record<string, unknown>;
      node[parts.at(-1)!] = value;
    }

    // Drives and the Quick Disk can be changed while the machine runs; the rest
    // is read when it starts, exactly as the ini is.
    const LIVE = /^(fdc\.drives\.\d+\.file|qdisk\.(file|writeProtected)|tape\.(file|instant))$/;
    let needsRestart = false;
    function markDirty(path: string) {
      if (!running()) return;
      if (LIVE.test(path)) { applyLive(path); return; }
      needsRestart = true;
      $('apply').hidden = false;
    }

    async function applyLive(path: string) {
      const drive = path.match(/^fdc\.drives\.(\d+)\.file$/);
      if (drive) {
        const index = Number(drive[1]);
        const file = fileById(machine.fdc.drives[index].file);
        if (!file) { await ejectFloppy(index); return; }
        writeFile(mediaPath(file.id), file.bytes);
        await mountFloppy(index, mediaPath(file.id));
        return;
      }
      if (path === 'qdisk.file') {
        const file = fileById(machine.qdisk.file);
        if (!file) { await mountQd(''); return; }
        writeFile(mediaPath(file.id), file.bytes);
        await mountQd(mediaPath(file.id));
        return;
      }
      if (path === 'qdisk.writeProtected') { await protectQd(machine.qdisk.writeProtected); return; }
      if (path === 'tape.instant') { await cmtHack(machine.tape.instant); return; }
      if (path === 'tape.file') {
        const file = fileById(machine.tape.file);
        if (!file) { await cmtInsert(''); return; }
        writeFile(mediaPath(file.id), file.bytes);
        await cmtInsert(mediaPath(file.id));
      }
    }

    /** The tape deck's own buttons, from the panel or the machine list. */
    let recording = '';
    async function deck(what: string) {
      if (!running()) return;
      const was = cmtState();
      if (what === 'play') await cmtPlay();
      else if (what === 'rew') await cmtStop();            // stop winds the tape back to the start
      else if (what === 'rec') await record();
      else if (what === 'stop') {
        await cmtStop();
        if (was === 4) await takeTape();                   // what the machine saved, into the file list
      } else {
        // STOP/EJECT: a second press on a tape that is already stopped.
        if (was > 1) { await cmtStop(); if (was === 4) await takeTape(); }
        else { await cmtInsert(''); machine.tape.file = ''; saveMachine(); renderMachine(); }
      }
      showDeck();
    }

    /** REC: a fresh tape in the deck, for the machine to SAVE onto. */
    async function record() {
      await cmtInsert('');
      recording = `tape-${new Date().toISOString().slice(11, 19).replace(/:/g, '')}.mzf`;
      if (!(await cmtRecord(mediaPath(recording)))) { recording = ''; return; }
      machine.tape.file = ''; saveMachine(); renderMachine();
    }

    /** The recorded tape, out of the machine and into YOUR FILES. */
    async function takeTape() {
      if (!recording) return;
      const bytes = readBack(mediaPath(recording));
      recording = '';
      if (!bytes?.length) return;
      const file = load('recorded.mzf', new Uint8Array(bytes));
      files.unshift(file);
      rememberFile({ id: file.id, name: file.name, bytes: file.bytes, ts: Date.now() });
      file.catalog = (await catalogIndex()).get(file.mzf?.crc32 ?? -1) ?? null;
      select(file);
    }

    /** What the deck is doing, next to its buttons and on the recorder. */
    let drawDeck: (() => void) | null = null;
    let drawDevices: (() => void) | null = null;
    function showDeck() {
      const box = document.getElementById('cmt-state');
      const state = running() ? cmtState() : 0;
      if (box) {
        const name = [ui.deckEmpty, ui.deckStopped, ui.deckPlaying, ui.deckPaused, 'REC'][state] ?? '';
        box.textContent = name + (state >= 2 ? ` · ${cmtPlaytime().toFixed(0)} s` : '');
      }
      drawDeck?.();
    }
    setInterval(showDeck, 700);

    /** The chosen file into the running machine: a program runs, a disk goes in. */
    async function sendToMachine(what: string) {
      if (!current) return;
      const file = current;
      if (what === 'emu-run') machine.program = file.id;
      // On tape it is read as the real machine reads it, so the instant load goes off.
      if (what === 'emu-tape') { machine.tape.file = file.id; machine.tape.instant = false; }
      // A drive is only there if its controller was on when the machine started.
      // Asking for the disk is asking for the drive, so the machine starts again
      // with it rather than waiting for Apply.
      const needsBoot = (what === 'emu-drive' && !machine.fdc.connected) || (what === 'emu-qd' && !machine.qdisk.connected);
      if (what === 'emu-drive') { machine.fdc.connected = true; machine.fdc.drives[0].file = file.id; }
      if (what === 'emu-qd') { machine.qdisk.connected = true; machine.qdisk.file = file.id; }
      saveMachine(); renderMachine();
      if (!running()) { startMachine(); return; }
      if (needsBoot) { location.reload(); return; }
      writeFile(mediaPath(file.id), file.bytes);
      if (what === 'emu-run') await runMzf(mediaPath(file.id));
      else if (what === 'emu-drive') await applyLive('fdc.drives.0.file');
      else if (what === 'emu-tape') { await cmtHack(false); await applyLive('tape.file'); }
      else await applyLive('qdisk.file');
      ($('canvas') as HTMLElement).focus();   // the keyboard belongs to the machine again
      track('tool-machine');
    }

    /** A disk the machine has written to, back into the file list. */
    async function takeImage(drive: number) {
      const chosen = fileById(machine.fdc.drives[drive].file);
      if (!chosen) return;
      const bytes = readBack(mediaPath(chosen.id));
      if (!bytes) return;
      const copy = load(chosen.name.replace(/(\.[^.]+)?$/, '-changed$1'), new Uint8Array(bytes));
      files.unshift(copy);
      rememberFile({ id: copy.id, name: copy.name, bytes: copy.bytes, ts: Date.now() });
      renderList(); renderMachine();
      status(ui.taken);
    }

    /** Resolves once the machine is advancing frames (or after a few seconds). */
    async function paced(limit = 8000) {
      const start = frames();
      const until = performance.now() + limit;
      while (performance.now() < until) {
        if (frames() > start) return true;
        await new Promise((r) => setTimeout(r, 100));
      }
      return false;
    }

    // Browsers keep the sound clock suspended until the visitor touches the
    // page; the first touch anywhere lets it go.
    for (const type of ['pointerdown', 'keydown']) document.addEventListener(type, () => wake(), { capture: true });

    let booted = false;
    async function startMachine() {
      const status = (text: string) => { $('emu-status').textContent = text; };
      status(ui.emuLoading);
      const media = mediaOf(machine).map(fileById).filter(Boolean).map((f) => ({ path: mediaPath(f!.id), bytes: f!.bytes }));
      try {
        await boot({
          canvas: $('canvas') as HTMLCanvasElement,
          version: EMU_VERSION,
          args: argsOf(machine),
          files: [{ path: '/mz800emu.ini', bytes: new TextEncoder().encode(toIni(machine)) }, ...media],
          dirs: ['/media/sd'],
          onStatus: status,
        });
        track('tool-emulator');
        // Requests are served by the emulation thread, so nothing can be asked
        // of it until it is actually running frames.
        await paced();
        if (!machine.tape.instant) await cmtHack(false);
        if (machine.tape.file) await applyLive('tape.file');
        showDeck();
      } catch (e) {
        // The runtime starts once per page; a different machine needs a fresh one.
        // A first boot that fails is reported instead, so the page cannot reload in a loop.
        if (booted) location.reload(); else status(String((e as Error)?.message ?? e));
      }
      booted = true;
    }


    $('emu-reset').addEventListener('click', () => resetMachine(!!machine.program));
    let muted = false;
    $('emu-mute').addEventListener('click', () => { muted = !muted; setMuted(muted); });
    // The keyboard under the screen, and the data recorder under that.
    keyboard($('mzkbd'), $('canvas'));
    drawDeck = recorder($('mzcmt'), {
          press: (key) => deck(key),
          state: () => (running() ? cmtState() : machine.tape.file ? 1 : 0),   // chosen but not yet started: in, stopped
          at: () => cmtPlaytime(),
          tape: () => fileById(machine.tape.file)?.name ?? (recording || ui.deckStopped),
          settings: () => {
            const t = machine.tape;
            const tapes = files.filter((f) => ['mzf', 'wav', 'tap'].includes(f.kind));
            const check = (path: string, label: string, on: boolean) => ({ check: label, on, pick: () => setMachine(path, !on) });
            return [
              ...(tapes.length
                ? [{ radio: ui.none, on: !t.file, pick: () => setMachine('tape.file', '') },
                   ...tapes.map((f) => ({ radio: f.name, on: f.id === t.file, pick: () => setMachine('tape.file', f.id) }))]
                : [{ note: ui.noImages }]),
              'sep' as const,
              check('tape.instant', ui.instantLoad, t.instant),
              ...(['SPEED_1/1', 'SPEED_2/1', 'SPEED_3/1', 'SPEED_4/1'] as const)
                .map((v) => ({ radio: `${ui.tapeSpeed} ${v.replace('SPEED_', '')}`, on: t.speed === v, pick: () => setMachine('tape.speed', v) })),
              check('tape.inverted', ui.tapeInverted, t.inverted),
              check('tape.boost', ui.tapeBoost, t.boost),
            ];
          },
          strings: { empty: ui.deckEmpty, noFf: ui.noFastForward, insert: ui.insert },
        });

    // The peripherals, each carrying its own settings: joysticks on the desk,
    // the Quick Disk beside them, the drives under the keyboard, the cards in
    // the machine's own column.
    const where: Record<string, HTMLElement> = { joy: $('dev-desk'), qdisk: $('dev-desk'), fdc: $('dev-storage'), ide: $('dev-storage') };
    drawDevices = devices({
      machine: () => machine,
      place: (id) => where[id] ?? $('devices'),
      files: (kinds) => files.filter((f) => kinds.includes(f.kind)).map((f) => ({ id: f.id, name: f.name })),
      set: setMachine,
      take: takeImage,
      strings: ui,
    });

    $('emu-fs').addEventListener('click', () => {
      const frame = $('emu-frame') as HTMLElement & { webkitRequestFullscreen?: () => void };
      (frame.requestFullscreen ?? frame.webkitRequestFullscreen)?.call(frame);
    });
    // The ini is read once, at start: a change to it means starting again.
    $('apply').addEventListener('click', () => { saveMachine(); location.reload(); });
    renderMachine();
  </script>
</Base>
