---
import Base from '../../layouts/Base.astro';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { useTranslations, localizePath, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const tt = t.studio;
// Content stamp of the emulator build, so a new one is not served from cache.
const emuVersion = createHash('md5')
  .update(readFileSync(new URL('../../../public/play/emu/mz800emu.wasm', import.meta.url)))
  .digest('hex')
  .slice(0, 8);
// Everything the client script needs to speak the visitor's language.
const ui = {
  ...Object.fromEntries(Object.entries(tt).filter(([, v]) => typeof v === 'string')),
  identifiedAs: tt.identifiedAs('{title}'),
  kinds: tt.kinds,
  titlePath: localizePath(lang, '/titles/'),
  playPath: localizePath(lang, '/play/'),
};
---
<Base lang={lang} title={tt.title} description={tt.description}>
  <article class="wb">
    <header class="wb-head">
      <h1>{tt.h1}</h1>
      <p class="lead">{tt.lead}</p>
    </header>

    <div class="dropbar wb-drop" id="drop" data-ui={JSON.stringify(ui)}>
      <input type="file" id="files" multiple hidden />
      <button class="btn primary" type="button" id="pick">{tt.choose}</button>
      <span class="meta">{tt.drop} · {tt.nothingUploaded}</span>
      <button class="btn ghost small" type="button" id="forget" hidden>{tt.forgetAll}</button>
    </div>

    <!-- The machine comes first: on a narrow screen it is what you see, and on a
         wide one everything else sits around it. -->
    <section class="wb-screen" aria-label={tt.emuTitle}>
      <div class="emu-screen" id="emu-frame">
        <!-- SDL's Emscripten backend looks the canvas up by this id; it cannot be renamed. -->
        <canvas id="canvas" tabindex="0" width="928" height="576"></canvas>
        <div id="emu-overlay" class="play-overlay">
          <button type="button" id="emu-start" class="btn">{tt.emuStart}</button>
        </div>
      </div>
      <div class="emu-controls">
        <button type="button" class="btn secondary small" id="emu-reset">{tt.resetMachine}</button>
        <button type="button" class="btn secondary small" id="emu-mute">{t.play.mute}</button>
        <button type="button" class="btn secondary small" id="emu-fs">{t.play.fullscreen}</button>
        <span class="meta" id="emu-status"></span>
      </div>
    </section>

    <aside class="wb-left">
      <h2 class="wb-h">{tt.yourFiles}</h2>
      <ul id="filelist" class="wb-list"></ul>
      <p class="meta" id="noFiles">{tt.empty}</p>
      <p class="meta wb-kept" id="keptNote" hidden>{tt.kept}</p>
      <div id="workbench" hidden>
        <div id="wb-actions" class="wb-actions"></div>
        <p class="meta" id="wb-say" hidden></p>
      </div>
      <h2 class="wb-h">{tt.groupNoFile}</h2>
      <button class="btn secondary small" type="button" id="act-characters">{tt.actCharacters}</button>
    </aside>

    <aside class="wb-right">
      <h2 class="wb-h">{tt.machine}</h2>
      <div class="machine-apply">
        <label>{tt.preset}
          <select id="preset">
            <option value="">—</option>
            <option value="plain">{tt.presetPlain}</option>
            <option value="floppy">{tt.presetFloppy}</option>
            <option value="card">{tt.presetCard}</option>
            <option value="everything">{tt.presetEverything}</option>
          </select>
        </label>
        <button type="button" class="btn primary small" id="apply">{tt.applyLive}</button>
      </div>
      <div class="machine" id="machine" data-emu={emuVersion} data-ui={JSON.stringify({
        none: tt.none, drive: tt.drive, connected: tt.connected, plugged: tt.plugged, size: tt.size, type: tt.type,
        readonly: tt.readonly, writeProtected: tt.writeProtected, keepWrites: tt.keepWrites, discardWrites: tt.discardWrites,
        mzpicoMode: tt.mzpicoMode, tapeSpeed: tt.tapeSpeed, tapeInverted: tt.tapeInverted, tapeBoost: tt.tapeBoost,
        soundOn: tt.soundOn, secondPsg: tt.secondPsg, joy1: tt.joy1, joy2: tt.joy2,
        joyNone: tt.joyNone, joyKeypad: tt.joyKeypad, joyStick: tt.joyStick, program: tt.program,
        drives: tt.drives, qdisk: tt.qdisk, ramdisk: tt.ramdisk, memext: tt.memext, cardSection: tt.cardSection,
        hdd: tt.hdd, tapeSection: tt.tapeSection, soundSection: tt.soundSection, takeImage: tt.takeImage, taken: tt.taken,
      })}></div>
      <p class="meta" id="apply-note">{tt.liveNote}</p>
    </aside>

    <section class="wb-below">
      <div id="wb-panel" class="wb-panel"></div>
      <div id="nofile-panel" class="wb-panel"></div>
      <p class="meta wb-later">{tt.later}</p>
    </section>
  </article>

  <script>
    import { load, actionsFor, catalogIndex, formatSize, type LoadedFile } from '../../lib/mz/workbench';
    import { setStrings, charactersPanel } from '../../lib/mz/panels';
    import { listFiles, rememberFile, forgetFile, forgetAll } from '../../lib/mz/store';
    import { boot, running, reset as resetMachine, mountFloppy, ejectFloppy, mountQd, protectQd, setMuted, writeFile, readBack } from '../../lib/mz/emulator';
    import { defaults, presets, toIni, mediaOf, argsOf, mediaPath, type Machine } from '../../lib/mz/machine';

    const drop = document.getElementById('drop')!;
    const ui = JSON.parse(drop.dataset.ui!) as Record<string, any>;
    setStrings(ui);
    const esc = (s: unknown) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const track = (e: string) => (window as unknown as { mzEvent?: (e: string) => void }).mzEvent?.(e);

    const files: LoadedFile[] = [];
    let current: LoadedFile | null = null;
    let openAction = '';

    const label = (id: string) => ui['act' + id.replace(/(^|-)([a-z])/g, (_: string, __: string, c: string) => c.toUpperCase())] ?? id;

    function renderList() {
      const list = $('filelist');
      $('noFiles').hidden = files.length > 0;
      $('keptNote').hidden = files.length === 0;
      $('forget').hidden = files.length === 0;
      list.innerHTML = files.map((f) => {
        const known = f.catalog ? ` · <a href="${esc(ui.titlePath + f.catalog.slug)}/">${esc(f.catalog.title)}</a>` : '';
        return `<li class="${f === current ? 'on' : ''}" data-id="${esc(f.id)}">
          <button type="button" class="wb-pick">
            <b>${esc(f.name)}</b>
            <span class="meta">${esc(formatSize(f.bytes.length))} · ${esc(ui.kinds[f.kind] ?? f.kind)}</span>
          </button>
          <span class="meta wb-known">${known}</span>
          <button type="button" class="wb-close" title="${esc(ui.remove)}" aria-label="${esc(ui.remove)}">✕</button>
        </li>`;
      }).join('');
      for (const li of list.querySelectorAll<HTMLElement>('li')) {
        const file = files.find((f) => f.id === li.dataset.id)!;
        li.querySelector('.wb-pick')!.addEventListener('click', () => select(file));
        li.querySelector('.wb-close')!.addEventListener('click', () => {
          files.splice(files.indexOf(file), 1);
          forgetFile(file.id);
          if (current === file) { current = files[0] ?? null; openAction = ''; }
          renderList(); renderActions();
        });
      }
    }

    function renderActions() {
      const box = $('workbench');
      box.hidden = !current;
      if (!current) return;
      const groups: Record<string, string[]> = {};
      for (const a of actionsFor(current)) (groups[a.group] ??= []).push(a.id);
      // A dump the catalog knows can be played straight away.
      if (current.catalog) (groups.use ??= []).push('play');
      const order = ['inspect', 'convert', 'use', 'share'] as const;
      $('wb-actions').innerHTML = order.filter((g) => groups[g]?.length).map((g) => `
        <div class="wb-group"><span class="wb-glabel">${esc(ui['group' + g[0].toUpperCase() + g.slice(1)])}</span>
          ${groups[g].map((id) => id === 'play'
            ? `<a class="btn secondary" href="${esc(ui.playPath + current!.catalog!.slug)}/">${esc(ui.actPlay)}</a>`
            : `<button class="btn secondary${openAction === id ? ' active' : ''}" type="button" data-act="${esc(id)}">${esc(label(id))}</button>`).join('')}
        </div>`).join('');
      for (const b of $('wb-actions').querySelectorAll<HTMLButtonElement>('button[data-act]')) {
        b.addEventListener('click', () => run(b.dataset.act!));
      }
      if (openAction) run(openAction, true);
    }

    async function run(id: string, keep = false) {
      if (!current) return;
      const action = actionsFor(current).find((a) => a.id === id);
      if (!action) return;
      const panel = $('wb-panel');
      const say = (message: string) => { const el = $('wb-say'); el.textContent = message; el.hidden = false; setTimeout(() => { el.hidden = true; }, 2500); };
      if (action.panel) {
        if (!keep && openAction === id) { openAction = ''; panel.innerHTML = ''; renderActions(); return; }
        openAction = id;
        panel.innerHTML = '';
        await action.run({ file: current, panel, say });
        if (!keep) renderActions();
      } else {
        await action.run({ file: current, panel, say });
      }
      track('tool-' + id);
    }

    function select(file: LoadedFile) {
      current = file;
      openAction = file.kind === 'mzf' ? 'header' : 'bytes';
      renderList(); renderActions();
    }

    async function add(fileList: FileList | null) {
      for (const f of [...(fileList ?? [])]) {
        const file = load(f.name, new Uint8Array(await f.arrayBuffer()));
        // The same file brought twice replaces the copy that is already here.
        const same = files.findIndex((o) => o.name === file.name && o.bytes.length === file.bytes.length);
        if (same >= 0) { forgetFile(files[same].id); files.splice(same, 1); }
        files.unshift(file);
        select(file);
        track('tool-open');
        // Kept in this browser, so a reload does not throw the work away.
        rememberFile({ id: file.id, name: file.name, bytes: file.bytes, ts: Date.now() });
        if (file.mzf) {
          file.catalog = (await catalogIndex()).get(file.mzf.crc32) ?? null;
          renderList(); renderActions();
        }
        renderMachine();
      }
    }

    const input = $<HTMLInputElement>('files');
    $('pick').addEventListener('click', () => input.click());
    input.addEventListener('change', () => add(input.files));
    for (const type of ['dragenter', 'dragover']) drop.addEventListener(type, (e) => { e.preventDefault(); drop.classList.add('over'); });
    for (const type of ['dragleave', 'drop']) drop.addEventListener(type, () => drop.classList.remove('over'));
    for (const target of [drop, document.body]) {
      target.addEventListener('drop', (e) => { e.preventDefault(); add((e as DragEvent).dataTransfer?.files ?? null); });
      target.addEventListener('dragover', (e) => e.preventDefault());
    }

    // Whatever was open last time, back as it was.
    (async () => {
      for (const stored of await listFiles()) files.push(load(stored.name, stored.bytes, stored.id));
      if (!files.length) return;
      select(files[0]);
      const index = await catalogIndex();
      for (const file of files) if (file.mzf) file.catalog = index.get(file.mzf.crc32) ?? null;
      renderList(); renderActions();
    })();

    $('forget').addEventListener('click', () => {
      files.length = 0; current = null; openAction = '';
      forgetAll();
      $('wb-panel').innerHTML = '';
      renderList(); renderActions();
    });


    // ---------------------------------------------------------------- emulator
    const mui = JSON.parse($('machine').dataset.ui!) as Record<string, string>;
    const EMU_VERSION = $('machine').dataset.emu ?? '1';
    let machine: Machine = defaults();
    try { machine = { ...defaults(), ...JSON.parse(localStorage.getItem('mz-machine') ?? '{}') }; } catch { /* first visit */ }
    const saveMachine = () => { try { localStorage.setItem('mz-machine', JSON.stringify(machine)); } catch { /* private mode */ } };

    const fileById = (id: string) => files.find((f) => f.id === id) ?? null;
    const option = (value: string, text: string, on: boolean) =>
      `<option value="${esc(value)}"${on ? ' selected' : ''}>${esc(text)}</option>`;
    /** Files of a kind, as a picker that always offers "empty". */
    const picker = (kinds: string[], chosen: string) =>
      [option('', mui.none, !chosen), ...files.filter((f) => kinds.includes(f.kind)).map((f) => option(f.id, f.name, f.id === chosen))].join('');
    const check = (path: string, label: string, on: boolean) =>
      `<label class="check"><input type="checkbox" data-set="${esc(path)}"${on ? ' checked' : ''}> ${esc(label)}</label>`;
    const chooser = (path: string, label: string, options: string) =>
      `<label>${esc(label)} <select data-set="${esc(path)}">${options}</select></label>`;

    // The panel is long, so each section remembers whether it is open.
    const OPEN_KEY = 'mz-machine-open';
    let openSections = new Set(['program', 'drives']);
    try {
      const kept = JSON.parse(localStorage.getItem(OPEN_KEY) ?? 'null');
      if (Array.isArray(kept)) openSections = new Set(kept);
    } catch { /* first visit */ }
    const fold = (key: string) => (openSections.has(key) ? ' open' : '');

    function renderMachine() {
      const m = machine;
      $('machine').innerHTML = `
        <details class="m-row" data-sect="program"${fold('program')}><summary>${esc(mui.program)}</summary>${chooser('program', '', picker(['mzf'], m.program))}</details>
        <details class="m-row" data-sect="drives"${fold('drives')}><summary>${esc(mui.drives)}</summary>
          ${check('fdc.connected', mui.connected, m.fdc.connected)}
          ${m.fdc.drives.map((d, i) => `${chooser(`fdc.drives.${i}.file`, `${mui.drive} ${i}`, picker(['dsk'], d.file))}
             ${check(`fdc.drives.${i}.readonly`, mui.readonly, d.readonly)}
             ${chooser(`fdc.drives.${i}.storage`, '', option('cached', mui.keepWrites, d.storage === 'cached') + option('discard', mui.discardWrites, d.storage === 'discard'))}
             ${d.file ? `<button class="btn ghost small" type="button" data-take="${i}">${esc(mui.takeImage)}</button>` : ''}`).join('<hr>')}
        </details>
        <details class="m-row" data-sect="qdisk"${fold('qdisk')}><summary>${esc(mui.qdisk)}</summary>
          ${check('qdisk.connected', mui.connected, m.qdisk.connected)}
          ${chooser('qdisk.type', mui.type, option('STANDARD', 'MZ-1F11', m.qdisk.type === 'STANDARD') + option('UNICARD', 'MZPico', m.qdisk.type === 'UNICARD'))}
          ${chooser('qdisk.file', '', picker(['mzq', 'bin'], m.qdisk.file))}
          ${check('qdisk.writeProtected', mui.writeProtected, m.qdisk.writeProtected)}
        </details>
        <details class="m-row" data-sect="ramdisk"${fold('ramdisk')}><summary>${esc(mui.ramdisk)}</summary>
          ${check('ramdisk.mr1r18.plugged', 'MR1R18', m.ramdisk.mr1r18.plugged)}
          ${chooser('ramdisk.mr1r18.size', mui.size, ['64K', '256K', '512K', '1M', '16M'].map((v) => option(v, v, m.ramdisk.mr1r18.size === v)).join(''))}
          ${chooser('ramdisk.mr1r18.type', mui.type, option('SRAM', 'SRAM', m.ramdisk.mr1r18.type === 'SRAM') + option('ROM', 'ROM', m.ramdisk.mr1r18.type === 'ROM'))}
          ${check('ramdisk.pezikE8', 'Pezik E8', m.ramdisk.pezikE8)}
          ${check('ramdisk.pezik68', 'Pezik 68', m.ramdisk.pezik68)}
        </details>
        <details class="m-row" data-sect="memext"${fold('memext')}><summary>${esc(mui.memext)}</summary>
          ${check('memext.connected', mui.connected, m.memext.connected)}
          ${chooser('memext.type', mui.type, option('PEHU', 'PEHU', m.memext.type === 'PEHU') + option('LUFTNER', 'Luftner', m.memext.type === 'LUFTNER'))}
        </details>
        <details class="m-row" data-sect="cardSection"${fold('cardSection')}><summary>${esc(mui.cardSection)}</summary>
          ${check('card.connected', mui.connected, m.card.connected)}
          ${check('card.mzpicoMode', mui.mzpicoMode, m.card.mzpicoMode)}
          ${check('card.readonly', mui.readonly, m.card.readonly)}
        </details>
        <details class="m-row" data-sect="hdd"${fold('hdd')}><summary>${esc(mui.hdd)}</summary>
          ${chooser('ide.hdd0', '0', picker(['bin'], m.ide.hdd0))}
          ${chooser('ide.hdd1', '1', picker(['bin'], m.ide.hdd1))}
        </details>
        <details class="m-row" data-sect="tapeSection"${fold('tapeSection')}><summary>${esc(mui.tapeSection)}</summary>
          ${chooser('tape.speed', mui.tapeSpeed, ['SPEED_1/1', 'SPEED_2/1', 'SPEED_3/1', 'SPEED_4/1'].map((v) => option(v, v.replace('SPEED_', ''), m.tape.speed === v)).join(''))}
          ${check('tape.inverted', mui.tapeInverted, m.tape.inverted)}
          ${check('tape.boost', mui.tapeBoost, m.tape.boost)}
        </details>
        <details class="m-row" data-sect="soundSection"${fold('soundSection')}><summary>${esc(mui.soundSection)}</summary>
          ${check('sound.on', mui.soundOn, m.sound.on)}
          ${check('sound.secondPsg', mui.secondPsg, m.sound.secondPsg)}
          ${chooser('joy.joy1', mui.joy1, (['NONE', 'NUM_KEYPAD', 'JOYSTICK'] as const).map((v) => option(v, v === 'NONE' ? mui.joyNone : v === 'NUM_KEYPAD' ? mui.joyKeypad : mui.joyStick, m.joy.joy1 === v)).join(''))}
          ${chooser('joy.joy2', mui.joy2, (['NONE', 'NUM_KEYPAD', 'JOYSTICK'] as const).map((v) => option(v, v === 'NONE' ? mui.joyNone : v === 'NUM_KEYPAD' ? mui.joyKeypad : mui.joyStick, m.joy.joy2 === v)).join(''))}
        </details>`;

      for (const d of $('machine').querySelectorAll<HTMLDetailsElement>('details[data-sect]')) {
        d.addEventListener('toggle', () => {
          if (d.open) openSections.add(d.dataset.sect!); else openSections.delete(d.dataset.sect!);
          try { localStorage.setItem(OPEN_KEY, JSON.stringify([...openSections])); } catch { /* private mode */ }
        });
      }
      for (const el of $('machine').querySelectorAll<HTMLElement>('[data-set]')) {
        el.addEventListener('change', () => {
          const input = el as HTMLInputElement | HTMLSelectElement;
          const value = input.type === 'checkbox' ? (input as HTMLInputElement).checked : input.value;
          setAt(machine as unknown as Record<string, unknown>, el.dataset.set!, value);
          saveMachine();
          markDirty(el.dataset.set!);
          renderMachine();
        });
      }
      for (const b of $('machine').querySelectorAll<HTMLButtonElement>('[data-take]')) {
        b.addEventListener('click', () => takeImage(Number(b.dataset.take)));
      }
    }

    function setAt(obj: Record<string, unknown>, path: string, value: unknown) {
      const parts = path.split('.');
      let node = obj as Record<string, unknown>;
      for (const part of parts.slice(0, -1)) node = node[part] as Record<string, unknown>;
      node[parts.at(-1)!] = value;
    }

    // Drives and the Quick Disk can be changed while the machine runs; the rest
    // is read when it starts, exactly as the ini is.
    const LIVE = /^(fdc\.drives\.\d+\.file|qdisk\.(file|writeProtected))$/;
    let needsRestart = false;
    function markDirty(path: string) {
      if (!running()) return;
      if (LIVE.test(path)) { applyLive(path); return; }
      needsRestart = true;
      $('apply-note').textContent = ui.needsRestart;
      ($('apply') as HTMLButtonElement).textContent = ui.applyRestart;
    }

    async function applyLive(path: string) {
      const drive = path.match(/^fdc\.drives\.(\d+)\.file$/);
      if (drive) {
        const index = Number(drive[1]);
        const file = fileById(machine.fdc.drives[index].file);
        if (!file) { await ejectFloppy(index); return; }
        writeFile(mediaPath(file.id), file.bytes);
        await mountFloppy(index, mediaPath(file.id));
        return;
      }
      if (path === 'qdisk.file') {
        const file = fileById(machine.qdisk.file);
        if (!file) { await mountQd(''); return; }
        writeFile(mediaPath(file.id), file.bytes);
        await mountQd(mediaPath(file.id));
        return;
      }
      if (path === 'qdisk.writeProtected') await protectQd(machine.qdisk.writeProtected);
    }

    /** A disk the machine has written to, back into the file list. */
    async function takeImage(drive: number) {
      const chosen = fileById(machine.fdc.drives[drive].file);
      if (!chosen) return;
      const bytes = readBack(mediaPath(chosen.id));
      if (!bytes) return;
      const copy = load(chosen.name.replace(/(\.[^.]+)?$/, '-changed$1'), new Uint8Array(bytes));
      files.unshift(copy);
      rememberFile({ id: copy.id, name: copy.name, bytes: copy.bytes, ts: Date.now() });
      renderList(); renderMachine();
      $('apply-note').textContent = mui.taken;
    }

    async function startMachine() {
      const status = (text: string) => { $('emu-status').textContent = text; };
      $('emu-overlay').hidden = true;
      status(ui.emuLoading);
      const media = mediaOf(machine).map(fileById).filter(Boolean).map((f) => ({ path: mediaPath(f!.id), bytes: f!.bytes }));
      try {
        await boot({
          canvas: $('canvas') as HTMLCanvasElement,
          version: EMU_VERSION,
          args: argsOf(machine),
          files: [{ path: '/mz800emu.ini', bytes: new TextEncoder().encode(toIni(machine)) }, ...media],
          dirs: ['/media/sd'],
          onStatus: status,
        });
        track('tool-emulator');
      } catch {
        // The runtime starts once per page; a different machine needs a fresh one.
        location.reload();
      }
    }

    $('emu-start').addEventListener('click', startMachine);
    $('emu-reset').addEventListener('click', () => resetMachine(!!machine.program));
    let muted = false;
    $('emu-mute').addEventListener('click', () => { muted = !muted; setMuted(muted); });
    $('emu-fs').addEventListener('click', () => {
      const frame = $('emu-frame') as HTMLElement & { webkitRequestFullscreen?: () => void };
      (frame.requestFullscreen ?? frame.webkitRequestFullscreen)?.call(frame);
    });
    $('preset').addEventListener('change', (e) => {
      const name = (e.target as HTMLSelectElement).value;
      if (!presets[name]) return;
      machine = presets[name]();
      saveMachine(); renderMachine(); markDirty('preset');
    });
    $('apply').addEventListener('click', async () => {
      saveMachine();
      if (!running()) { startMachine(); return; }
      if (needsRestart) { location.reload(); return; }
      for (let i = 0; i < 4; i++) await applyLive(`fdc.drives.${i}.file`);
      await applyLive('qdisk.file');
      await resetMachine(!!machine.program);
    });
    renderMachine();

    // The one tool that needs no file.
    const charBtn = $<HTMLButtonElement>('act-characters');
    charBtn.addEventListener('click', () => {
      const panel = $('nofile-panel');
      const open = charBtn.classList.toggle('active');
      panel.innerHTML = '';
      if (open) { charactersPanel(panel); track('tool-characters'); }
    });
  </script>
</Base>
