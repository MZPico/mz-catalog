---
import Base from '../../layouts/Base.astro';
import { useTranslations, localizePath, type Lang } from '../../i18n';
import type { CollectionEntry } from 'astro:content';

interface Props { lang: Lang; entry: CollectionEntry<'titles'> }
const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const p = (path: string) => localizePath(lang, path);
const d = entry.data;
const machineLabel: Record<string, string> = { 'mz-700': 'MZ-700', 'mz-800': 'MZ-800', 'mz-1500': 'MZ-1500' };
const languageName = (code: string) => {
  try { return new Intl.DisplayNames([lang], { type: 'language' }).of(code) ?? code; } catch { return code; }
};
const hex4 = (n: number) => '$' + n.toString(16).toUpperCase().padStart(4, '0');
const kb = (n: number) => (n / 1024).toFixed(1) + ' KB';
const description = typeof d.description === 'string' ? d.description : d.description?.[lang] ?? d.description?.en;
const paragraphs = (description ?? '').trim().split(/\n\s*\n/).filter(Boolean);
const summary = t.title.summary(d.title, machineLabel[d.machine], d.genre.join(', '), d.year);

// Social/AI preview: the 1200x630 card built by tools/og/build-og.py from the
// gameplay shot. Titles without screenshots fall back to the site-wide card.
const ogCard = d.screenshots.length ? `/og/${d.slug}.png` : undefined;
const abs = (path: string) => new URL(path, Astro.site).href;
const gameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: d.title,
  url: abs(p(`/titles/${d.slug}/`)),
  applicationCategory: 'Game',
  gamePlatform: `Sharp ${machineLabel[d.machine]}`,
  operatingSystem: `Sharp ${machineLabel[d.machine]}`,
  isAccessibleForFree: true,
  ...(d.genre.length ? { genre: d.genre } : {}),
  ...(d.year ? { datePublished: String(d.year) } : {}),
  ...(d.publisher ? { publisher: { '@type': 'Organization', name: d.publisher } } : {}),
  ...(d.language ? { inLanguage: d.language } : {}),
  ...(d.original ? { isBasedOn: {
    '@type': 'VideoGame',
    name: d.original.title ?? d.title,
    ...(d.original.year ? { datePublished: String(d.original.year) } : {}),
    ...(d.original.publisher ? { publisher: { '@type': 'Organization', name: d.original.publisher } } : {}),
  } } : {}),
  description: description ?? summary,
  ...(d.screenshots.length ? { image: d.screenshots.map((f) => abs(`/screenshots/${d.slug}/${f}`)) } : {}),
  downloadUrl: abs(`/files/${d.slug}/${d.files[0].path}`),
  ...(d.machine !== 'mz-1500' ? { installUrl: abs(p(`/play/${d.slug}/`)) } : {}),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.meta.siteName, item: abs(p('/')) },
    { '@type': 'ListItem', position: 2, name: machineLabel[d.machine], item: abs(p(`/machines/${d.machine}/`)) },
    { '@type': 'ListItem', position: 3, name: d.title, item: abs(p(`/titles/${d.slug}/`)) },
  ],
};
---
<Base lang={lang} title={d.title} description={summary}
  image={ogCard}
  imageAlt={ogCard ? `${d.title} — screenshot` : undefined}
  jsonLd={[gameLd, breadcrumbLd]}>
  <article data-pagefind-body>
    <div class="title-head">
      <h1>{d.title}</h1>
      <span class="meta">{[d.year, d.publisher].filter(Boolean).join(' · ')}</span>
      {d.original && (
        <span class="meta original">{t.title.original}: {[d.original.title, d.original.publisher, d.original.year].filter(Boolean).join(', ')}{d.port === 'zx-spectrum' && ' (ZX Spectrum)'}</span>
      )}
    </div>
    <div class="title-badges">
      <a class:list={['badge', d.machine]} href={p(`/machines/${d.machine}/`)} data-pagefind-filter="machine">{machineLabel[d.machine]}</a>
      {d.mode && <span class="tag" title={t.title.modeTitle}>{d.mode === 'native' ? t.title.modeNative : t.title.mode700}</span>}
      {d.port === 'zx-spectrum' && <span class="tag zx" title={t.title.portTitle}>{t.title.portZx}</span>}
      {d.genre.map((g) => <span class="tag" data-pagefind-filter="genre">{g}</span>)}
      {d.language && <span class="tag" title={t.title.languageTitle}>{languageName(d.language)}</span>}
    </div>

    <div class="actionbar" data-pagefind-ignore>
      {d.files.length === 1 ? (
        <>
          {d.machine !== 'mz-1500' && <a class="btn primary" href={p(`/play/${d.slug}/?file=${d.files[0].path}`)}>{t.title.play}</a>}
          <a class="btn" href={`/files/${d.slug}/${d.files[0].path}`} download>{t.title.download}</a>
          <button class="btn" type="button" id="tape-toggle" aria-expanded="false" aria-controls="tape-panel">{t.title.tapeAudio}</button>
        </>
      ) : (
        <div class="multi">
          {d.files.map((f) => (
            <div class="tape-row">
              <span class="file-label">{f.path}</span>
              {d.machine !== 'mz-1500' && <a class="btn primary" href={p(`/play/${d.slug}/?file=${f.path}`)}>{t.title.playShort}</a>}
              <a class="btn" href={`/files/${d.slug}/${f.path}`} download>{t.title.downloadShort}</a>
            </div>
          ))}
          <button class="btn" type="button" id="tape-toggle" aria-expanded="false" aria-controls="tape-panel">♪ Tape audio</button>
        </div>
      )}
    </div>

    <section data-pagefind-ignore class="tape-audio tape-panel" id="tape-panel" hidden data-machine={d.machine}
      data-i18n={JSON.stringify({ generating: t.tape.generating, ready: t.tape.ready('{len}'), downloadFailed: t.tape.downloadFailed(0) })}>
      <p class="hint" set:html={t.tape.hintHtml} />
      {d.files.map((f) => (
        <div class="tape-row" data-file={`/files/${d.slug}/${f.path}`} data-name={f.header?.name ?? f.path}>
          <span class="mono file">{f.path}</span>
          <label>{t.tape.layout}
            <select class="tape-layout">
              <option value="short" selected>{t.tape.layoutFast}</option>
              <option value="authentic">{t.tape.layoutAuthentic}</option>
            </select>
          </label>
          <label class="pol"><input type="checkbox" class="tape-invert" /> {t.tape.invert}</label>
          <button class="btn accent tape-play" type="button">{t.tape.play}</button>
          <button class="btn tape-download" type="button">{t.tape.downloadWav}</button>
          <span class="tape-status meta"></span>
          <audio class="tape-player" controls preload="none" hidden></audio>
        </div>
      ))}
    </section>

    {d.screenshots.length > 0 && (
      <ul class="shots">
        {d.screenshots.map((s, i) => (
          <li>
            <img src={`/screenshots/${d.slug}/${s}`} alt={t.title.screenshotAlt(d.title, i + 1)} loading={i === 0 ? 'eager' : 'lazy'}
              {...(i === 0 ? { 'data-pagefind-meta': 'image[src]' } : {})} />
          </li>
        ))}
      </ul>
    )}

    {paragraphs.length > 0 ? (
      <section class="prose">
        <h2>{t.title.aboutGame}</h2>
        {paragraphs.map((p) => <p>{p}</p>)}
      </section>
    ) : (
      <p class="not-curated">{t.title.notCurated}</p>
    )}

    <section class="community" data-pagefind-ignore data-slug={d.slug}
      data-i18n={JSON.stringify({ votes: [t.title.votes(1), t.title.votes(2), t.title.votes(5)], unrated: t.title.unrated, thanks: t.title.rateThanks })}>
      <div class="rating">
        <span class="label">{t.title.rate}</span>
        <div class="stars" role="radiogroup" aria-label={t.title.rate}>
          {[1, 2, 3, 4, 5].map((n) => (
            <button type="button" class="star" role="radio" aria-checked="false" data-value={n} aria-label={t.title.starLabel(n)}>★</button>
          ))}
        </div>
        <span class="rating-summary meta">{t.title.unrated}</span>
      </div>
      <div class="plays meta"><span class="label">{t.title.plays}</span> <span class="plays-count">—</span></div>
    </section>

    {d.controls && (
      <section>
        <h2>{t.title.controls}</h2>
        <pre class="controls">{d.controls.trim()}</pre>
      </section>
    )}

    <section data-pagefind-ignore>
      <h2>{t.title.files}</h2>
      <details class="tech">
      <summary>{t.title.techDetails}</summary>
      <div class="table-wrap">
        <table class="files">
          <thead>
            <tr><th>{t.title.th.file}</th><th>{t.title.th.kind}</th><th>{t.title.th.tapeName}</th><th>{t.title.th.type}</th><th>{t.title.th.load}</th><th>{t.title.th.exec}</th><th>{t.title.th.bodySize}</th><th>{t.title.th.fileSize}</th><th>{t.title.th.crc}</th></tr>
          </thead>
          <tbody>
            {d.files.map((f) => (
              <>
                <tr>
                  <td class="mono">{f.path}</td>
                  <td>{t.title.kinds[f.kind]}</td>
                  <td class="mono">{f.header?.name}</td>
                  <td>{f.header?.attributeName}</td>
                  <td class="mono">{f.header ? hex4(f.header.loadAddress) : ''}</td>
                  <td class="mono">{f.header ? hex4(f.header.execAddress) : ''}</td>
                  <td class="mono">{f.header ? hex4(f.header.dataSize) : ''}</td>
                  <td title={`${f.size} bytes`}>{kb(f.size)}</td>
                  <td class="mono">{f.crc32}</td>
                </tr>
                {f.note && <tr><td class="note" colspan="9">{f.note}</td></tr>}
              </>
            ))}
          </tbody>
        </table>
      </div>
      </details>
    </section>
  </article>
</Base>

<script>
  import { mzfToWav } from '../../lib/mzf2wav.js';

  // "♪ Tape audio" reveals the tape panel.
  const tapeToggle = document.getElementById('tape-toggle');
  const tapePanel = document.getElementById('tape-panel');
  if (tapeToggle && tapePanel) {
    tapeToggle.addEventListener('click', () => {
      const open = tapePanel.hidden;
      tapePanel.hidden = !open;
      tapeToggle.setAttribute('aria-expanded', String(open));
      if (open) tapePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }

  const section = document.querySelector('.tape-audio') as HTMLElement | null;
  const i18n = JSON.parse(section?.dataset.i18n ?? '{}');
  if (section) {
    const machine = section.dataset.machine === 'mz-700' ? 'mz-700' : 'mz-800';

    for (const row of section.querySelectorAll<HTMLElement>('.tape-row')) {
      const status = row.querySelector('.tape-status') as HTMLElement;
      const player = row.querySelector('.tape-player') as HTMLAudioElement;
      let cached: { url: string; name: string } | null = null;
      let mzfBytes: Uint8Array | null = null;

      const invalidate = () => {
        if (cached) { URL.revokeObjectURL(cached.url); cached = null; }
        player.pause(); player.removeAttribute('src'); player.hidden = true;
        status.textContent = '';
      };
      row.querySelector('.tape-layout')!.addEventListener('change', invalidate);
      row.querySelector('.tape-invert')!.addEventListener('change', invalidate);

      const generate = async () => {
        if (cached) return cached;
        status.textContent = i18n.generating;
        if (!mzfBytes) {
          const resp = await fetch(row.dataset.file!);
          if (!resp.ok) throw new Error(String(i18n.downloadFailed).replace('0', String(resp.status)));
          mzfBytes = new Uint8Array(await resp.arrayBuffer());
        }
        const layout = (row.querySelector('.tape-layout') as HTMLSelectElement).value as 'short' | 'authentic';
        const invert = (row.querySelector('.tape-invert') as HTMLInputElement).checked;
        const { wav, seconds, name } = mzfToWav(mzfBytes, { machine, layout, invert });
        const blob = new Blob([wav.buffer as ArrayBuffer], { type: 'audio/wav' });
        cached = { url: URL.createObjectURL(blob), name: name || 'tape' };
        const m = Math.floor(seconds / 60), sec = Math.round(seconds % 60);
        status.textContent = String(i18n.ready).replace('{len}', `${m}:${String(sec).padStart(2, '0')}`);
        return cached;
      };

      row.querySelector('.tape-play')!.addEventListener('click', async () => {
        try {
          const { url } = await generate();
          if (player.getAttribute('src') !== url) { player.src = url; player.hidden = false; }
          player.play();
        } catch (err) {
          status.textContent = String(err);
        }
      });

      row.querySelector('.tape-download')!.addEventListener('click', async () => {
        try {
          const { url, name } = await generate();
          const a = document.createElement('a');
          a.href = url;
          a.download = `${name.toLowerCase().replace(/[^a-z0-9-]+/g, '-')}.wav`;
          a.click();
        } catch (err) {
          status.textContent = String(err);
        }
      });
    }
  }
</script>

<script>
  // Community numbers: play counts and ratings, served by the site Worker.
  // The page itself stays static — these arrive after it renders.
  {
    const section = document.querySelector<HTMLElement>('.community');
    if (section) {
      const slug = section.dataset.slug!;
      const ui = JSON.parse(section.dataset.i18n!) as { votes: string[]; unrated: string; thanks: string };
      const summary = section.querySelector<HTMLElement>('.rating-summary')!;
      const playsCount = section.querySelector<HTMLElement>('.plays-count')!;
      const stars = [...section.querySelectorAll<HTMLButtonElement>('.star')];

      // A random id in localStorage is what keeps one visitor from stuffing the
      // ballot; there is no account and no cookie behind it.
      let voter = localStorage.getItem('mz-voter');
      if (!voter) {
        voter = crypto.randomUUID();
        try { localStorage.setItem('mz-voter', voter); } catch { /* private mode */ }
      }

      const plural = (n: number) => (n === 1 ? ui.votes[0] : n < 5 ? ui.votes[1] : ui.votes[2]).replace(/\d+/, String(n));
      const paint = (s: { plays?: number; votes?: number; avg?: number; mine?: number }) => {
        summary.textContent = s.votes ? `★ ${s.avg!.toFixed(1)} · ${plural(s.votes)}` : ui.unrated;
        playsCount.textContent = String(s.plays ?? 0);
        for (const star of stars) {
          const on = s.mine ? Number(star.dataset.value) <= s.mine : false;
          star.classList.toggle('on', on);
          star.setAttribute('aria-checked', String(Number(star.dataset.value) === s.mine));
        }
      };

      const load = async () => {
        const res = await fetch(`/api/stats?slug=${encodeURIComponent(slug)}&voter=${voter}`);
        if (res.ok) paint(await res.json());
      };
      load().catch(() => {});

      for (const star of stars) {
        star.addEventListener('click', async () => {
          const value = Number(star.dataset.value);
          paint({ mine: value });
          const res = await fetch('/api/rate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, value, voter }),
          }).catch(() => null);
          if (res?.ok) {
            paint(await res.json());
            summary.insertAdjacentHTML('afterend', `<span class="thanks meta">${ui.thanks}</span>`);
            setTimeout(() => section.querySelector('.thanks')?.remove(), 2000);
          } else {
            load().catch(() => {}); // refused (capped or throttled): show the truth again
          }
        });
      }
    }
  }
</script>
