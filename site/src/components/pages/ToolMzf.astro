---
import Base from '../../layouts/Base.astro';
import { useTranslations, localizePath, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const tt = t.tools;
const ui = {
  name: tt.name, type: tt.type, load: tt.load, exec: tt.exec, bodySize: tt.bodySize, fileSize: tt.fileSize,
  crc: tt.crc, bodyCrc: tt.bodyCrc, notes: tt.notes, identified: tt.identified,
  identifiedAs: tt.identifiedAs('{title}'), unknown: tt.unknown, identifying: tt.identifying,
  headerSection: tt.headerSection, bodySection: tt.bodySection, rawBytes: tt.rawBytes,
  attributeByte: tt.attributeByte, nameBytes: tt.nameBytes, rest: tt.rest, restNote: tt.restNote,
  chars: tt.chars, setAscii: tt.setAscii, setDisplay: tt.setDisplay, setFile: tt.setFile,
  setGlyph1: tt.setGlyph1, setGlyph2: tt.setGlyph2,
  addresses: tt.addresses, addrOffset: tt.addrOffset, addrMemory: tt.addrMemory, goto: tt.goto,
  emptyBody: tt.emptyBody, titlePath: localizePath(lang, '/titles/'),
};
---
<Base lang={lang} title={tt.mzfTitle} description={tt.mzfLead}>
  <article data-pagefind-body>
    <h1>{tt.mzfTitle}</h1>
    <p class="lead">{tt.mzfLead}</p>

    <div class="dropzone" id="drop" data-pagefind-ignore data-ui={JSON.stringify(ui)}>
      <p>{tt.drop}</p>
      <input type="file" id="files" multiple accept=".mzf,.mzt,.m12,.MZF" hidden />
      <button class="btn primary" type="button" id="pick">{tt.choose}</button>
      <p class="meta">{tt.nothingUploaded}</p>
    </div>
    <div id="out" data-pagefind-ignore></div>
  </article>

  <script>
    import { readMzf, problems, hex, MZF_HEADER_SIZE, type MzfFile } from '../../lib/mz/mzf';
    import { hexView, glyphChar, type CharColumn } from '../../lib/mz/hexview';

    const drop = document.getElementById('drop')!;
    const ui = JSON.parse(drop.dataset.ui!) as Record<string, string>;
    const out = document.getElementById('out')!;
    const input = document.getElementById('files') as HTMLInputElement;
    const esc = (s: unknown) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const kb = (n: number) => `${(n / 1024).toFixed(1)} KB`;
    const bytesHex = (b: Uint8Array) => [...b].map((x) => x.toString(16).toUpperCase().padStart(2, '0')).join(' ');

    let index: Promise<Map<string, { slug: string; title: string }>> | null = null;
    const catalog = () => (index ??= fetch('/manifest.json').then((r) => r.json()).then((m: any) => {
      const map = new Map<string, { slug: string; title: string }>();
      for (const title of m.titles ?? []) for (const f of title.files ?? []) map.set(f.crc32, { slug: title.slug, title: title.title });
      return map;
    }).catch(() => new Map()));

    const row = (label: string, value: string, raw = '') =>
      `<tr><td>${esc(label)}</td><td class="mono">${esc(value)}</td><td class="mono raw">${esc(raw)}</td></tr>`;

    function card(fileName: string, m: MzfFile): HTMLElement {
      const h = m.header;
      const notes = problems(m);
      const el = document.createElement('section');
      el.className = 'tool-card';
      const nameField = m.bytes.subarray(1, 18);
      el.innerHTML = `<h2>${esc(fileName)}</h2>
        <p class="identify meta">${esc(ui.identifying)}</p>

        <h3>${esc(ui.headerSection)}</h3>
        <table class="rank fields"><tbody>
          ${h ? row(ui.attributeByte, `${h.attribute.toString(16).toUpperCase().padStart(2, '0')} — ${h.attributeName}`) +
                row(ui.name, h.name || '—', bytesHex(nameField)) +
                row(ui.load, hex(h.loadAddress), bytesHex(m.bytes.subarray(20, 22))) +
                row(ui.exec, hex(h.execAddress), bytesHex(m.bytes.subarray(22, 24))) +
                row(ui.bodySize, `${h.dataSize} B (${kb(h.dataSize)})`, bytesHex(m.bytes.subarray(18, 20))) : ''}
          ${row(ui.fileSize, `${m.size} B (${kb(m.size)})`)}
          ${row(ui.crc, m.crc32)}
          ${row(ui.bodyCrc, m.bodyCrc32)}
        </tbody></table>
        ${notes.length ? `<ul class="notes">${notes.map((n) => `<li>${esc(n)}</li>`).join('')}</ul>` : ''}
        ${h ? `<details class="rest"><summary>${esc(ui.rest)}</summary>
            <p class="meta">${esc(ui.restNote)}</p>
            <p class="mzglyph rest-text">${esc([...h.comment].map((b) => glyphChar(b)).join(''))}</p>
            <div class="rest-hex"></div></details>` : ''}

        <h3>${esc(ui.bodySection)}</h3>
        <div class="hv-toolbar">
          <label>${esc(ui.chars)}
            <select class="charset">
              <option value="glyph1">${esc(ui.setGlyph1)}</option>
              <option value="glyph2">${esc(ui.setGlyph2)}</option>
              <option value="file">${esc(ui.setFile)}</option>
              <option value="display">${esc(ui.setDisplay)}</option>
              <option value="ascii">${esc(ui.setAscii)}</option>
            </select>
          </label>
          <label>${esc(ui.addresses)}
            <select class="addrmode">
              <option value="memory">${esc(ui.addrMemory)}</option>
              <option value="offset">${esc(ui.addrOffset)}</option>
            </select>
          </label>
          <label>${esc(ui.goto)} <input class="goto mono" size="6" placeholder="1200" /></label>
        </div>
        <div class="body-hex"></div>`;

      const body = m.bytes.subarray(MZF_HEADER_SIZE);
      const host = el.querySelector<HTMLElement>('.body-hex')!;
      if (!body.length) host.innerHTML = `<p class="meta">${esc(ui.emptyBody)}</p>`;
      else {
        const base = h?.loadAddress ?? null;
        const view = hexView(host, { bytes: body, base, charset: 'glyph1' });
        el.querySelector<HTMLSelectElement>('.charset')!.addEventListener('change', (e) =>
          view.setCharset((e.target as HTMLSelectElement).value as CharColumn));
        const addr = el.querySelector<HTMLSelectElement>('.addrmode')!;
        if (base === null) { addr.value = 'offset'; addr.disabled = true; }
        addr.addEventListener('change', () => view.setBase(addr.value === 'memory' ? base : null));
        el.querySelector<HTMLInputElement>('.goto')!.addEventListener('change', (e) => {
          const value = parseInt((e.target as HTMLInputElement).value.replace(/^[$#]|0x/i, ''), 16);
          if (!Number.isNaN(value)) view.goTo(value);
        });
      }
      if (h) hexView(el.querySelector<HTMLElement>('.rest-hex')!, { bytes: h.comment, base: 24, charset: 'glyph1' });
      return el;
    }

    function skeleton(fileName: string, m: MzfFile): string {
      const name = (m.header?.name || fileName.replace(/\.[^.]+$/, '')).trim();
      const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 20) || 'untitled';
      return `# titles/${slug}/meta.yaml\ntitle: "${name}"\nmachine: mz-800\nmode: native\ngenre: [game]\nfiles:\n  - path: ${slug}.mzf\n    kind: standard\nsource: "Tape image, CRC-32 ${m.crc32}."\n`;
    }

    async function show(file: File) {
      const bytes = new Uint8Array(await file.arrayBuffer());
      const m = readMzf(bytes);
      const el = card(file.name, m);
      out.prepend(el);
      (window as unknown as { mzEvent?: (e: string) => void }).mzEvent?.('tool-mzf');
      const hit = (await catalog()).get(m.crc32);
      const line = el.querySelector('.identify')!;
      if (hit) {
        line.classList.add('hit');
        line.innerHTML = `<b>${esc(ui.identified)}</b> ${esc(ui.identifiedAs.replace('{title}', hit.title))} ` +
          `<a href="${esc(ui.titlePath + hit.slug)}/">${esc(hit.title)} →</a>`;
      } else {
        line.innerHTML = `${esc(ui.unknown)}<pre class="mono skeleton">${esc(skeleton(file.name, m))}</pre>`;
      }
    }

    const take = (files: FileList | null) => { for (const f of [...(files ?? [])]) show(f); };
    document.getElementById('pick')!.addEventListener('click', () => input.click());
    input.addEventListener('change', () => take(input.files));
    for (const type of ['dragenter', 'dragover']) drop.addEventListener(type, (e) => { e.preventDefault(); drop.classList.add('over'); });
    for (const type of ['dragleave', 'drop']) drop.addEventListener(type, () => drop.classList.remove('over'));
    drop.addEventListener('drop', (e) => { e.preventDefault(); take((e as DragEvent).dataTransfer?.files ?? null); });
  </script>
</Base>
