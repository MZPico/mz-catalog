---
import Base from '../../layouts/Base.astro';
import { useTranslations, localizePath, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const repo = 'https://github.com/MZPico/mz-catalog';
---
<Base lang={lang} title={t.about.title}>
  <article class="prose" data-pagefind-ignore>
    <h1>{t.about.h1}</h1>
    <p set:html={t.about.introHtml} />
    <p set:html={t.about.cardHtml(localizePath(lang, '/card/'))} />

    <h2>{t.about.contributingH2}</h2>
    <p set:html={t.about.contributingHtml(repo)} />

    <h2 id="takedown">{t.about.takedownH2}</h2>
    <p set:html={t.about.takedownHtml(repo)} />
  </article>
</Base>
