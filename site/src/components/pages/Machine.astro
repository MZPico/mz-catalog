---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import type { Machine } from '../../data/machines';
import { useTranslations, localizePath, type Lang } from '../../i18n';

interface Props { lang: Lang; machine: Machine }
const { lang, machine } = Astro.props;
const t = useTranslations(lang);
const p = (path: string) => localizePath(lang, path);
const info = t.machineInfo[machine.id as keyof typeof t.machineInfo];
const titles = (await getCollection('titles'))
  .filter((e) => e.data.web && e.data.machine === machine.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'en', { sensitivity: 'base' }));
---
<Base lang={lang} title={machine.name} description={t.machines.overviewDescription(machine.name)}>
  <h1>{machine.name}</h1>
  <p class="meta">{machine.years}</p>
  <p class="lead">{info.intro}</p>

  <h2>{t.machines.specs}</h2>
  <dl class="facts">
    {info.specs.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
  </dl>
  <p class="meta"><small>{info.softwareNote}</small></p>

  <h2>{t.machines.inCatalog(titles.length)}</h2>
  {titles.length > 0 ? (
    <ul class="grid">
      {titles.map(({ data: d }) => {
        const shot = d.screenshots.find((f) => f.startsWith('02')) ?? d.screenshots[0];
        return (
          <li class="card">
            <a class="thumb" href={p(`/titles/${d.slug}/`)} aria-hidden="true" tabindex="-1">
              {shot
                ? <img src={`/screenshots/${d.slug}/${shot}`} alt="" loading="lazy" width="640" height="480" />
                : <div class="thumb-empty">{t.home.noScreenshot}</div>}
            </a>
            <a class="card-play" href={p(`/play/${d.slug}/`)} title={t.home.playAria(d.title)} aria-label={t.home.playAria(d.title)}>▶</a>
            <div class="body">
              <h3><a href={p(`/titles/${d.slug}/`)}>{d.title}</a></h3>
              <div class="meta">{[d.year, d.publisher].filter(Boolean).join(' · ') || ' '}</div>
            </div>
          </li>
        );
      })}
    </ul>
  ) : (
    <p>{t.machines.none}</p>
  )}
</Base>
