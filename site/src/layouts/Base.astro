---
import '../styles/global.css';
import { locales, defaultLang, localizePath, stripLang, useTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Absolute site path of the preview image for social/AI cards. */
  image?: string;
  imageAlt?: string;
  /** schema.org objects embedded as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { lang = defaultLang, title, description, image, imageAlt, jsonLd } = Astro.props;
const t = useTranslations(lang);
const fullTitle = title ? `${title} · ${t.meta.siteName}` : t.meta.homeTitle;
const repo = 'https://github.com/MZPico/mz-catalog';
const staging = process.env.MZ_STAGING === '1';

// The same page in every language, for hreflang and the language switcher.
const basePath = stripLang(Astro.url.pathname);
const alternates = locales.map((l) => ({
  lang: l,
  href: new URL(localizePath(l, basePath), Astro.site).href,
  path: localizePath(l, basePath),
}));
const p = (path: string) => localizePath(lang, path);

const metaDescription = description ?? t.meta.defaultDescription;
const imageUrl = new URL(image ?? '/og-default.png', Astro.site).href;
// og:locale wants the POSIX form; our locale codes are the short ones.
const ogLocale: Record<Lang, string> = { en: 'en_GB', cs: 'cs_CZ', de: 'de_DE', ja: 'ja_JP' };
const structured = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? t.meta.defaultDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="preload" href="/fonts/mz800.woff2?v=8" as="font" type="font/woff2" crossorigin />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(basePath, Astro.site).href} />
    {staging && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={imageUrl} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocale[a.lang]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={imageUrl} />

    {structured.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={p('/')}>SHARP&nbsp;MZ&nbsp;<b>SOFTWARE&nbsp;CATALOG</b><span class="cursor"></span></a>
        {staging && <span class="staging-badge" title="Preview build — not the live site">STAGING</span>}
        <nav>
          <a href={p('/card/')}>{t.nav.card}</a>
          <a href={p('/')}>{t.nav.titles}</a>
          <a href={p('/archive/')}>{t.nav.archive}</a>
          <a href={p('/machines/')}>{t.nav.machines}</a>
          <a href={p('/about/')}>{t.nav.about}</a>
          <a href={repo} rel="noopener">{t.nav.github}</a>
          <details class="lang-switch">
            <summary title={t.langSwitchLabel} aria-label={t.langSwitchLabel}>{t.langName[lang]}<span class="caret">▾</span></summary>
            <ul>
              {alternates.map((a) => (
                <li>
                  <a href={a.path} hreflang={a.lang} lang={a.lang} aria-current={a.lang === lang ? 'true' : undefined}>
                    {t.langName[a.lang]}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{t.footer.blurb}</p>
        <p set:html={t.footer.rightsHtml(p('/about/'))} />
      </div>
    </footer>
  </body>
</html>
