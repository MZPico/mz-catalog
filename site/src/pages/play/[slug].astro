---
import Play from '../../components/pages/Play.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const titles = await getCollection('titles');
  return titles
    .filter((e) => e.data.machine !== 'mz-1500')
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
if (entry.data.play) return Astro.redirect(entry.data.play, 301);   // a native build replaces the emulator
---
<Play lang="en" entry={entry} />
