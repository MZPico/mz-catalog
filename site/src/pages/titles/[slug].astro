---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const titles = await getCollection('titles');
  return titles
    .filter((e) => e.data.web).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const t = entry.data;
const machineLabel: Record<string, string> = { 'mz-700': 'MZ-700', 'mz-800': 'MZ-800', 'mz-1500': 'MZ-1500' };
const kindLabel: Record<string, string> = { standard: 'Standard', turbo: 'Turbo loader', 'alt-dump': 'Alternative dump' };
const languageName = (code: string) => {
  try { return new Intl.DisplayNames(['en'], { type: 'language' }).of(code) ?? code; } catch { return code; }
};
const hex4 = (n: number) => '$' + n.toString(16).toUpperCase().padStart(4, '0');
const kb = (n: number) => (n / 1024).toFixed(1) + ' KB';
const paragraphs = (t.description ?? '').trim().split(/\n\s*\n/).filter(Boolean);
const isUrl = (s: string) => /^https?:\/\//.test(s);
const repoMeta = `https://github.com/MZPico/mz-catalog/blob/main/titles/${t.slug}/meta.yaml`;
const summary = `${t.title} — ${machineLabel[t.machine]} ${t.genre.join(', ')}${t.year ? ` (${t.year})` : ''}. Download the .mzf tape image.`;
---
<Base title={t.title} description={summary}>
  <article data-pagefind-body>
    <div class="title-head">
      <h1>{t.title}</h1>
      <span class="meta">{[t.year, t.publisher].filter(Boolean).join(' · ')}</span>
    </div>
    <div class="title-badges">
      <a class:list={['badge', t.machine]} href={`/machines/${t.machine}/`} data-pagefind-filter="machine">{machineLabel[t.machine]}</a>
      {t.mode && <span class="tag" title="MZ-800 operating mode">{t.mode === 'native' ? 'MZ-800 native mode' : 'MZ-700 compatibility mode'}</span>}
      {t.genre.map((g) => <span class="tag" data-pagefind-filter="genre">{g}</span>)}
      {t.language && <span class="tag" title="Language">{languageName(t.language)}</span>}
    </div>

    <div class="actionbar" data-pagefind-ignore>
      {t.files.length === 1 ? (
        <>
          {t.machine !== 'mz-1500' && <a class="btn primary" href={`/play/${t.slug}/?file=${t.files[0].path}`}>▶ Play in browser</a>}
          <a class="btn" href={`/files/${t.slug}/${t.files[0].path}`} download>⬇ Download .mzf</a>
          <button class="btn" type="button" id="tape-toggle" aria-expanded="false" aria-controls="tape-panel">♪ Tape audio</button>
        </>
      ) : (
        <div class="multi">
          {t.files.map((f) => (
            <div class="tape-row">
              <span class="file-label">{f.path}</span>
              {t.machine !== 'mz-1500' && <a class="btn primary" href={`/play/${t.slug}/?file=${f.path}`}>▶ Play</a>}
              <a class="btn" href={`/files/${t.slug}/${f.path}`} download>⬇ .mzf</a>
            </div>
          ))}
          <button class="btn" type="button" id="tape-toggle" aria-expanded="false" aria-controls="tape-panel">♪ Tape audio</button>
        </div>
      )}
    </div>

    <section data-pagefind-ignore class="tape-audio tape-panel" id="tape-panel" hidden data-machine={t.machine}>
      <p class="hint">Turn any phone or laptop into a Sharp datacorder: connect the
      headphone output to the MZ's tape-in (read) jack, set volume to maximum, press PLAY here, and type{" "}
      <code>L</code> + CR (monitor)  or the boot menu's <code>C</code> on the machine.
      Or download the WAV for later.</p>
      {t.files.map((f) => (
        <div class="tape-row" data-file={`/files/${t.slug}/${f.path}`} data-name={f.header?.name ?? f.path}>
          <span class="mono file">{f.path}</span>
          <label>Layout
            <select class="tape-layout">
              <option value="short" selected>fast (short pilot)</option>
              <option value="authentic">authentic (with retry copies)</option>
            </select>
          </label>
          <label class="pol"><input type="checkbox" class="tape-invert" /> invert polarity</label>
          <button class="btn accent tape-play" type="button">▶ Play tape audio</button>
          <button class="btn tape-download" type="button">⬇ Download .wav</button>
          <span class="tape-status meta"></span>
          <audio class="tape-player" controls preload="none" hidden></audio>
        </div>
      ))}
    </section>

    {t.screenshots.length > 0 && (
      <ul class="shots">
        {t.screenshots.map((s, i) => (
          <li>
            <img src={`/screenshots/${t.slug}/${s}`} alt={`${t.title} screenshot ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'}
              {...(i === 0 ? { 'data-pagefind-meta': 'image[src]' } : {})} />
          </li>
        ))}
      </ul>
    )}

    {paragraphs.length > 0 && (
      <section class="prose">
        <h2>About</h2>
        {paragraphs.map((p) => <p>{p}</p>)}
      </section>
    )}

    {t.controls && (
      <section>
        <h2>Controls</h2>
        <pre class="controls">{t.controls.trim()}</pre>
      </section>
    )}

    <section data-pagefind-ignore>
      <h2>Files</h2>
      <details class="tech">
      <summary>Technical details — tape header, addresses, checksums</summary>
      <div class="table-wrap">
        <table class="files">
          <thead>
            <tr><th>File</th><th>Kind</th><th>Tape name</th><th>Type</th><th>Load</th><th>Exec</th><th>Size</th><th>CRC-32</th></tr>
          </thead>
          <tbody>
            {t.files.map((f) => (
              <>
                <tr>
                  <td class="mono">{f.path}</td>
                  <td>{kindLabel[f.kind]}</td>
                  <td class="mono">{f.header?.name}</td>
                  <td>{f.header?.attributeName}</td>
                  <td class="mono">{f.header ? hex4(f.header.loadAddress) : ''}</td>
                  <td class="mono">{f.header ? hex4(f.header.execAddress) : ''}</td>
                  <td title={`${f.size} bytes`}>{kb(f.size)}</td>
                  <td class="mono">{f.crc32}</td>
                </tr>
                {f.note && <tr><td class="note" colspan="8">{f.note}</td></tr>}
              </>
            ))}
          </tbody>
        </table>
      </div>
      <p class="meta"><small>MZF = 128-byte Sharp tape header + program data. Load in an emulator, write to tape, or copy to an MZPico card.</small></p>
      </details>
    </section>


    <section data-pagefind-ignore>
      <h2>Provenance</h2>
      <dl class="facts">
        <dt>Source</dt>
        <dd>{t.source ? (isUrl(t.source) ? <a href={t.source} rel="noopener">{t.source}</a> : t.source) : 'Not recorded'}</dd>
        <dt>Catalog entry</dt>
        <dd><a href={repoMeta} rel="noopener">titles/{t.slug}/meta.yaml</a> — corrections welcome via pull request.</dd>
      </dl>
    </section>
  </article>
</Base>

<script>
  import { mzfToWav } from '../../lib/mzf2wav.js';

  // "♪ Tape audio" reveals the tape panel.
  const tapeToggle = document.getElementById('tape-toggle');
  const tapePanel = document.getElementById('tape-panel');
  if (tapeToggle && tapePanel) {
    tapeToggle.addEventListener('click', () => {
      const open = tapePanel.hidden;
      tapePanel.hidden = !open;
      tapeToggle.setAttribute('aria-expanded', String(open));
      if (open) tapePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }

  const section = document.querySelector('.tape-audio') as HTMLElement | null;
  if (section) {
    const machine = section.dataset.machine === 'mz-700' ? 'mz-700' : 'mz-800';

    for (const row of section.querySelectorAll<HTMLElement>('.tape-row')) {
      const status = row.querySelector('.tape-status') as HTMLElement;
      const player = row.querySelector('.tape-player') as HTMLAudioElement;
      let cached: { url: string; name: string } | null = null;
      let mzfBytes: Uint8Array | null = null;

      const invalidate = () => {
        if (cached) { URL.revokeObjectURL(cached.url); cached = null; }
        player.pause(); player.removeAttribute('src'); player.hidden = true;
        status.textContent = '';
      };
      row.querySelector('.tape-layout')!.addEventListener('change', invalidate);
      row.querySelector('.tape-invert')!.addEventListener('change', invalidate);

      const generate = async () => {
        if (cached) return cached;
        status.textContent = 'generating…';
        if (!mzfBytes) {
          const resp = await fetch(row.dataset.file!);
          if (!resp.ok) throw new Error(`download failed (${resp.status})`);
          mzfBytes = new Uint8Array(await resp.arrayBuffer());
        }
        const layout = (row.querySelector('.tape-layout') as HTMLSelectElement).value as 'short' | 'authentic';
        const invert = (row.querySelector('.tape-invert') as HTMLInputElement).checked;
        const { wav, seconds, name } = mzfToWav(mzfBytes, { machine, layout, invert });
        const blob = new Blob([wav.buffer as ArrayBuffer], { type: 'audio/wav' });
        cached = { url: URL.createObjectURL(blob), name: name || 'tape' };
        const m = Math.floor(seconds / 60), sec = Math.round(seconds % 60);
        status.textContent = `${m}:${String(sec).padStart(2, '0')} tape — play at 100% volume into the MZ tape-in`;
        return cached;
      };

      row.querySelector('.tape-play')!.addEventListener('click', async () => {
        try {
          const { url } = await generate();
          if (player.getAttribute('src') !== url) { player.src = url; player.hidden = false; }
          player.play();
        } catch (err) {
          status.textContent = String(err);
        }
      });

      row.querySelector('.tape-download')!.addEventListener('click', async () => {
        try {
          const { url, name } = await generate();
          const a = document.createElement('a');
          a.href = url;
          a.download = `${name.toLowerCase().replace(/[^a-z0-9-]+/g, '-')}.wav`;
          a.click();
        } catch (err) {
          status.textContent = String(err);
        }
      });
    }
  }
</script>
