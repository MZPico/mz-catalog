---
// Private dashboard for the monitor (workers/site/metrics.js). Not linked, not in
// the sitemap, noindex; the data needs the STATS_KEY secret, which the owner's
// link carries in the URL fragment (#k=…) so it never reaches a server log.
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>mzpico.com · stats</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- is:global — the dashboard is drawn by script, so Astro's scoped styles would never reach it. -->
    <style is:global>
      .stats { max-width: 1180px; margin: 0 auto; padding: 1.2rem 1rem 3rem; }
      .stats-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.8rem 1.2rem; margin-bottom: 1rem; }
      .stats-head h1 { margin: 0; font-size: 1.4rem; }
      .ranges { display: flex; gap: 0.3rem; }
      .ranges button { background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: 6px; padding: 0.3rem 0.7rem; cursor: pointer; font: inherit; }
      .ranges button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
      .stats .meta { color: var(--muted); font-size: 0.85rem; }
      .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(165px, 1fr)); gap: 0.7rem; margin-bottom: 1.2rem; }
      .kpi { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.75rem 0.9rem; }
      .kpi .label { color: var(--muted); font-size: 0.82rem; }
      .kpi .value { font-size: 1.7rem; font-variant-numeric: tabular-nums; margin: 0.15rem 0; }
      .kpi .delta { font-size: 0.8rem; color: var(--muted); }
      .kpi .delta b { color: var(--text); font-weight: 600; }
      .panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 0.9rem; }
      .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.8rem 0.9rem; min-width: 0; }
      .panel.wide { grid-column: 1 / -1; }
      .panel h2 { margin: 0 0 0.6rem; }
      .chart { position: relative; }
      .chart svg { display: block; width: 100%; height: auto; overflow: visible; }
      .chart .axis { fill: var(--muted); font-size: 11px; font-family: var(--sans); }
      .chart .grid { stroke: var(--line); stroke-width: 1; }
      .chart .hit { fill: transparent; }
      .chart .hit:hover { fill: rgba(255,255,255,0.05); }
      .tip { position: absolute; pointer-events: none; background: var(--surface-2); border: 1px solid var(--line); border-radius: 6px; padding: 0.35rem 0.5rem; font-size: 0.8rem; white-space: nowrap; z-index: 2; }
      .tip .sw { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 0.35rem; }
      .legend { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; font-size: 0.8rem; color: var(--muted); margin-top: 0.4rem; }
      .legend .sw { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 0.35rem; vertical-align: -1px; }
      table.rank { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
      table.rank td { padding: 0.22rem 0.3rem; border-top: 1px solid var(--line); vertical-align: top; }
      table.rank td.n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; width: 1%; }
      table.rank td.bar { width: 28%; }
      table.rank .fill { height: 6px; border-radius: 3px; background: var(--accent); opacity: 0.75; }
      table.rank .cls { color: var(--muted); font-size: 0.78rem; }
      .empty { color: var(--muted); font-size: 0.85rem; }
      .keyform { max-width: 30rem; margin: 3rem auto; display: grid; gap: 0.6rem; }
      .keyform input { font: inherit; padding: 0.5rem; background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: 6px; }
      .viz { --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --s5: #d55181; --s6: #9085e9; }
    </style>
  </head>
  <body>
    <main class="stats viz">
      <div class="stats-head">
        <h1>mzpico.com · stats</h1>
        <div class="ranges" role="group" aria-label="Period">
          <button type="button" data-days="7">7 days</button>
          <button type="button" data-days="30">30 days</button>
          <button type="button" data-days="90">90 days</button>
          <button type="button" data-days="365">1 year</button>
        </div>
        <span class="meta" id="generated"></span>
      </div>
      <div id="out"></div>
      <p class="meta">People are counted by the page beacon (robots excluded, Do Not Track respected); today's numbers are partial.
        Robots, AI crawlers, card traffic, downloads and errors come from Cloudflare's analytics, copied each night for the day before.
        Changes compare with the previous period of the same length.</p>
    </main>

    <script is:inline>
      const out = document.getElementById('out');
      const fromHash = new URLSearchParams(location.hash.slice(1)).get('k');
      let key = fromHash;
      try { if (fromHash) localStorage.setItem('mz-stats-key', fromHash); else key = localStorage.getItem('mz-stats-key'); } catch {}
      if (fromHash) history.replaceState(null, '', location.pathname + location.search);

      const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
      const fmt = (n) => Number(n).toLocaleString('en-US');
      const dayList = (from, to) => { const r = []; for (let d = Date.parse(from); d <= Date.parse(to); d += 86400000) r.push(new Date(d).toISOString().slice(0, 10)); return r; };

      function askKey(msg) {
        out.innerHTML = `<form class="keyform"><p>${esc(msg)}</p><input name="k" placeholder="stats key" autocomplete="off"><button class="btn primary">Show</button></form>`;
        out.querySelector('form').onsubmit = (e) => { e.preventDefault(); key = e.target.k.value.trim(); try { localStorage.setItem('mz-stats-key', key); } catch {} load(); };
      }

      // ---- charts: one series per chart (no dual axes); robots are one stacked chart.
      function barChart(days, series, { height = 150, width = 720 } = {}) {
        const W = width, H = height, L = 34, B = 18, T = 6;
        const totals = days.map((_, i) => series.reduce((s, x) => s + (x.values[i] || 0), 0));
        const max = Math.max(1, ...totals);
        const step = niceStep(max);
        const top = Math.ceil(max / step) * step;
        const y = (v) => T + (H - T - B) * (1 - v / top);
        const bw = (W - L) / days.length;
        const gap = Math.min(2, bw * 0.2);
        let g = '';
        for (let v = 0; v <= top; v += step) g += `<line class="grid" x1="${L}" x2="${W}" y1="${y(v)}" y2="${y(v)}"/><text class="axis" x="${L - 6}" y="${y(v) + 4}" text-anchor="end">${fmt(v)}</text>`;
        const every = Math.ceil(days.length / (W / 72));
        days.forEach((d, i) => {
          const x = L + i * bw;
          let base = 0;
          series.forEach((s, si) => {
            const v = s.values[i] || 0; if (!v) return;
            const y0 = y(base), y1 = y(base + v);
            const isTop = series.slice(si + 1).every((t) => !(t.values[i] || 0));
            const h = Math.max(0, y0 - y1 - (base ? gap : 0));
            const r = isTop ? Math.min(3, (bw - gap) / 2) : 0;
            g += `<path d="${roundTop(x + gap / 2, y1, bw - gap, h, r)}" fill="${s.color}"/>`;
            base += v;
          });
          if (i % every === 0) g += `<text class="axis" x="${x + bw / 2}" y="${H - 4}" text-anchor="middle">${d.slice(5)}</text>`;
          g += `<rect class="hit" data-i="${i}" x="${x}" y="${T}" width="${bw}" height="${H - T - B}"/>`;
        });
        const el = document.createElement('div');
        el.className = 'chart';
        el.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img">${g}</svg><div class="tip" hidden></div>`
          + (series.length > 1 ? `<div class="legend">${series.map((s) => `<span><span class="sw" style="background:${s.color}"></span>${esc(s.name)}</span>`).join('')}</div>` : '');
        const tip = el.querySelector('.tip');
        el.querySelector('svg').addEventListener('mousemove', (e) => {
          const i = e.target.dataset?.i; if (i === undefined) { tip.hidden = true; return; }
          const rows = series.filter((s) => s.values[i]).map((s) => `<div><span class="sw" style="background:${s.color}"></span>${esc(s.name)}: <b>${fmt(s.values[i])}</b></div>`);
          tip.innerHTML = `<div class="meta">${days[i]}</div>${rows.join('') || '<div>0</div>'}${series.length > 1 ? `<div>total <b>${fmt(totals[i])}</b></div>` : ''}`;
          tip.hidden = false;
          const r = el.getBoundingClientRect();
          const x = e.clientX - r.left + 12;
          tip.style.left = `${Math.min(x, r.width - tip.offsetWidth - 4)}px`;
          tip.style.top = `${e.clientY - r.top + 10}px`;
        });
        el.querySelector('svg').addEventListener('mouseleave', () => { tip.hidden = true; });
        return el;
      }
      const niceStep = (max) => { const raw = max / 4, p = 10 ** Math.floor(Math.log10(raw)); return [1, 2, 5, 10].map((m) => m * p).find((s) => s >= raw); };
      const roundTop = (x, y, w, h, r) => h <= 0 ? '' : `M${x},${y + h} V${y + r} Q${x},${y} ${x + r},${y} H${x + w - r} Q${x + w},${y} ${x + w},${y + r} V${y + h} Z`;

      function rank(rows, { label = (k) => esc(k), limit = 12 } = {}) {
        if (!rows.length) return '<p class="empty">nothing yet</p>';
        const max = rows[0][1];
        return `<table class="rank">${rows.slice(0, limit).map(([k, v]) => `<tr><td>${label(k)}</td><td class="bar"><div class="fill" style="width:${(v / max) * 100}%"></div></td><td class="n">${fmt(v)}</td></tr>`).join('')}</table>`
          + (rows.length > limit ? `<p class="meta">+ ${rows.length - limit} more</p>` : '');
      }

      const BOT_CLASSES = [
        ['ai-live', 'AI: a person asked', 'var(--s3)'], ['ai-search', 'AI search', 'var(--s1)'], ['ai-train', 'AI training', 'var(--s6)'],
        ['search', 'search engines', 'var(--s4)'], ['seo', 'SEO tools', 'var(--s5)'], ['other', 'other robots', 'var(--s2)'],
      ];
      const SOURCE_CLASS = { ai: 'AI assistant', search: 'search', social: 'social', site: 'link', tag: 'campaign', direct: '', other: '' };

      async function load() {
        if (!key) return askKey('This page needs the stats key.');
        let days = 30;
        try { days = Number(localStorage.getItem('mz-stats-days')) || 30; } catch {}
        document.querySelectorAll('.ranges button').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.days) === days)));
        out.innerHTML = '<p class="meta">loading…</p>';
        const res = await fetch(`/api/metrics?days=${days * 2}`, { headers: { 'X-Stats-Key': key } });
        if (res.status === 401) return askKey('That key was not accepted.');
        const data = await res.json();
        document.getElementById('generated').textContent = `updated ${new Date(data.generated).toLocaleString()}`;
        const all = dayList(data.from, data.to);
        const cur = all.slice(-days), prev = all.slice(0, all.length - days);
        const inCur = new Set(cur), inPrev = new Set(prev);
        const sum = (set, metric, keyTest = () => true) => data.rows.reduce((s, [d, m, k, v]) => (set.has(d) && m === metric && keyTest(k) ? s + v : s), 0);
        const byKey = (metric, keyTest = () => true) => {
          const m = new Map();
          for (const [d, mm, k, v] of data.rows) if (inCur.has(d) && mm === metric && keyTest(k)) m.set(k, (m.get(k) || 0) + v);
          return [...m].sort((a, b) => b[1] - a[1]);
        };
        const perDay = (metric, keyTest = () => true) => cur.map((d) => data.rows.reduce((s, [dd, m, k, v]) => (dd === d && m === metric && keyTest(k) ? s + v : s), 0));

        const kpi = (label, metric, keyTest) => {
          const a = sum(inCur, metric, keyTest), b = sum(inPrev, metric, keyTest);
          const delta = b ? `<b>${a >= b ? '+' : '−'}${Math.abs(Math.round(((a - b) / b) * 100))} %</b> vs previous ${days} days` : (a ? 'new' : '—');
          return `<div class="kpi"><div class="label">${label}</div><div class="value">${fmt(a)}</div><div class="delta">${delta}</div></div>`;
        };
        const isAi = (k) => k.startsWith('ai:');
        out.innerHTML = `<div class="kpis">
            ${kpi('Visitors', 'visitors')}
            ${kpi('Page views (people)', 'page')}
            ${kpi('Plays', 'plays')}
            ${kpi('Visits from AI assistants', 'source', isAi)}
            ${kpi('MZPico cards (devices)', 'card-devices')}
            ${kpi('AI crawler page fetches', 'bot', (k) => k.startsWith('ai-'))}
          </div>
          <div class="panels">
            <section class="panel wide"><h2>Visitors per day</h2><div id="c-visitors"></div></section>
            <section class="panel"><h2>Plays per day</h2><div id="c-plays"></div></section>
            <section class="panel"><h2>MZPico cards per day</h2><div id="c-cards"></div></section>
            <section class="panel"><h2>MZPico card downloads per day</h2><div id="c-card"></div></section>
            <section class="panel wide"><h2>Robots per day (pages fetched)</h2><div id="c-bots"></div></section>
            <section class="panel"><h2>Where people came from</h2>${rank(byKey('source'), { label: (k) => { const [c, n] = k.includes(':') ? k.split(/:(.*)/) : [k, k]; return `${esc(n)} <span class="cls">${esc(SOURCE_CLASS[c] ?? '')}</span>`; } })}</section>
            <section class="panel"><h2>Most visited pages</h2>${rank(byKey('page'), { label: (k) => `<a href="${esc(k)}">${esc(k)}</a>` })}</section>
            <section class="panel"><h2>Most played</h2>${rank(byKey('play'), { label: (k) => `<a href="/titles/${esc(k)}/">${esc(k)}</a>` })}</section>
            <section class="panel"><h2>Most downloaded .mzf</h2>${rank(byKey('download'), { label: (k) => `<a href="/titles/${esc(k)}/">${esc(k)}</a>` })}</section>
            <section class="panel"><h2>AI crawlers</h2>${rank(byKey('bot', (k) => k.startsWith('ai-')), { label: (k) => esc(k.split('|')[1]) })}</section>
            <section class="panel"><h2>Other robots</h2>${rank(byKey('bot', (k) => !k.startsWith('ai-')), { label: (k) => esc(k.split('|')[1]) })}</section>
            <section class="panel"><h2>Countries</h2>${rank(byKey('country'))}</section>
            <section class="panel"><h2>Languages · devices</h2>${rank(byKey('lang'))}${rank(byKey('device'))}</section>
            <section class="panel"><h2>Features used</h2>${rank(byKey('event'))}</section>
            <section class="panel"><h2>Card: most downloaded</h2>${rank(byKey('card-dl'), { label: (k) => `<a href="/titles/${esc(k)}/">${esc(k)}</a>` })}</section>
            <section class="panel"><h2>Card: folders opened</h2>${rank(byKey('card-list'))}</section>
            <section class="panel"><h2>Card: not found</h2>${rank(byKey('card-miss'))}<p class="meta">Folders or files a card asked for that the catalog does not have.</p></section>
            <section class="panel"><h2>Card: countries</h2>${rank(byKey('card-country'))}</section>
            <section class="panel"><h2>Health</h2>${rank([...byKey('health').filter(([, v]) => v).map(([, v]) => ['server errors (5xx)', v]),
              ...[[ 'scanner probes on api.mzpico.com', sum(inCur, 'card-scan') || sum(inCur, 'card', (k) => k === 'other') ]].filter(([, v]) => v)])}
              <p class="meta">All time: ${fmt(data.totals.plays ?? 0)} plays of ${fmt(data.totals.titles_played ?? 0)} titles, ${fmt(data.totals.votes ?? 0)} ratings.</p></section>
          </div>`;
        document.getElementById('c-visitors').append(barChart(cur, [{ name: 'visitors', values: perDay('visitors'), color: 'var(--s1)' }]));
        document.getElementById('c-plays').append(barChart(cur, [{ name: 'plays', values: perDay('plays'), color: 'var(--s3)' }], { height: 170, width: 360 }));
        document.getElementById('c-cards').append(barChart(cur, [{ name: 'cards', values: perDay('card-devices'), color: 'var(--s6)' }], { height: 170, width: 360 }));
        // The card Worker counts downloads itself from 12 Sep; before that, Cloudflare's request totals.
        const own = perDay('card-dl'), cf = perDay('card', (k) => k === 'download');
        document.getElementById('c-card').append(barChart(cur, [{ name: 'downloads', values: own.map((v, i) => v || cf[i]), color: 'var(--s6)' }], { height: 170, width: 360 }));
        document.getElementById('c-bots').append(barChart(cur, BOT_CLASSES.map(([cls, name, color]) => ({ name, color, values: perDay('bot', (k) => k.split('|')[0] === cls) }))));
      }

      document.querySelectorAll('.ranges button').forEach((b) => b.addEventListener('click', () => {
        try { localStorage.setItem('mz-stats-days', b.dataset.days); } catch {}
        load();
      }));
      load();
    </script>
  </body>
</html>
